      "label": "Maximum Width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "default": 1320,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Header Text & Colors"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "COMPRAR STICKERS Y BANNERS"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#ffcc00"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Un pedido claro desde el principio."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Cards Styling"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge Background Color",
      "default": "#ffcc00"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_desc_color",
      "label": "Card Description Color",
      "default": "#a1a1aa"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top Padding (px)",
      "default": 60
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom Padding (px)",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon/Image (Optional)",
          "info": "Replaces the default numbered circle badge if selected."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Step Heading",
          "default": "Configura"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Elige tamaño, cantidad y acabado."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Impress Steps Process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "heading": "Configura",
            "description": "Elige tamaño, cantidad y acabado."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Sube tu arte",
            "description": "Adjunta el archivo a tu pedido."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Aprueba",
            "description": "Revisa la prueba antes de producir."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Recibe",
            "description": "Selecciona envío o recogida."
          }
