<div 
  class="impress-steps-outer-wrapper" 
  style="
    --bg-color: {{ section.settings.bg_color }};
    --padding-top: {{ section.settings.padding_top }}px; 
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --max-width: {{ section.settings.max_width }}px;
  "
>
  <div class="impress-steps-container">
    <!-- Header Content -->
    {% if section.settings.subheading != blank %}
      <span class="impress-steps-subheading" style="--subheading-color: {{ section.settings.subheading_color }};">
        {{ section.settings.subheading }}
      </span>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="impress-steps-heading" style="--heading-color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <!-- Step Blocks Grid -->
    <div class="impress-steps-grid">
      {% for block in section.blocks %}
        <div class="impress-step-card" {{ block.shopify_attributes }}>
          <div class="impress-step-icon-wrapper">
            {% if block.settings.custom_icon != blank %}
              <img 
                src="{{ block.settings.custom_icon | image_url: width: 120 }}" 
                alt="{{ block.settings.heading | escape }}" 
                loading="lazy"
                width="40"
                height="40"
                class="impress-step-custom-icon"
              >
            {% else %}
              <div class="impress-step-number" style="--badge-bg: {{ section.settings.badge_bg }}; --badge-color: {{ section.settings.badge_color }};">
                {{ forloop.index }}
              </div>
            {% endif %}
          </div>

          {% if block.settings.heading != blank %}
            <h3 class="impress-step-title" style="--title-color: {{ section.settings.card_title_color }};">
              {{ block.settings.heading }}
            </h3>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="impress-step-description" style="--desc-color: {{ section.settings.card_desc_color }};">
              {{ block.settings.description }}
            </p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .impress-steps-outer-wrapper {
    width: 100%;
    background-color: var(--bg-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    box-sizing: border-box;
  }

  .impress-steps-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
    box-sizing: border-box;
  }

  .impress-steps-subheading {
    display: block;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--subheading-color, #ffcc00);
    margin-bottom: 12px;
  }

  .impress-steps-heading {
    font-size: 40px;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.8px;
    color: var(--heading-color, #ffffff);
    margin: 0 0 48px 0;
  }

  .impress-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 32px;
    width: 100%;
  }

  .impress-step-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .impress-step-icon-wrapper {
    margin-bottom: 20px;
    min-height: 40px;
    display: flex;
    align-items: center;
  }

  .impress-step-number {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--badge-bg, #ffcc00);
    color: var(--badge-color, #000000);
    font-size: 16px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .impress-step-custom-icon {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .impress-step-title {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--title-color, #ffffff);
    margin: 0 0 12px 0;
  }

  .impress-step-description {
    font-size: 15px;
    line-height: 1.5;
    color: var(--desc-color, #a1a1aa);
    margin: 0;
  }

  @media (max-width: 768px) {
    .impress-steps-heading {
      font-size: 28px;
      margin-bottom: 32px;
    }

    .impress-steps-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
