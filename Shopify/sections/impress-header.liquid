      "default": "Need custom volume or bulk specs?"
    },
    {
      "type": "text",
      "id": "banner_btn_label",
      "label": "Dropdown Banner Button Label",
      "default": "Get Custom Quote"
    },
    {
      "type": "url",
      "id": "banner_btn_url",
      "label": "Dropdown Banner Button Link"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "📁 New Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column Title",
          "default": "Productos"
        }
      ]
    },
    {
      "type": "item_card",
