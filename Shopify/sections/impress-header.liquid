      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Stickers"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description",
          "default": "Vinilo brillante resiste agua y sol."
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
