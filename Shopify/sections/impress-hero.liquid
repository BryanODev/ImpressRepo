<div 
  class="impress-hero-outer-wrapper" 
  style="
    --padding-top: {{ section.settings.padding_top }}px; 
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --max-width: {{ section.settings.max_width }}px;
  "
>
  <div 
    class="impress-hero-card" 
    style="
      --card-bg: {{ section.settings.card_bg }}; 
      --card-radius: {{ section.settings.card_radius }}px;
      --card-min-height: {{ section.settings.card_min_height }}px;
      --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    "
  >
    {% if section.settings.bg_image != blank %}
      <div class="impress-hero-bg-image-wrapper">
        <img 
          src="{{ section.settings.bg_image | image_url: width: 2000 }}" 
          alt="{{ section.settings.bg_image.alt | escape }}"
          loading="eager"
          width="{{ section.settings.bg_image.width }}"
          height="{{ section.settings.bg_image.height }}"
          class="impress-hero-bg-image"
        >
        <div class="impress-hero-overlay"></div>
      </div>
    {% endif %}

    <div class="impress-hero-content">
      {% if section.settings.subheading != blank %}
        <span class="impress-hero-subheading" style="--subheading-color: {{ section.settings.subheading_color }};">
          {{ section.settings.subheading }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="impress-hero-heading" style="--heading-color: {{ section.settings.heading_color }};">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="impress-hero-description" style="--desc-color: {{ section.settings.desc_color }};">
          {{ section.settings.description }}
        </p>
      {% endif %}

      <div class="impress-hero-actions">
        {% if section.settings.primary_btn_text != blank %}
          <a href="{{ section.settings.primary_btn_link }}" class="impress-hero-btn impress-hero-btn-primary">
            {{ section.settings.primary_btn_text }}
          </a>
        {% endif %}

        {% if section.settings.secondary_btn_text != blank %}
          <a href="{{ section.settings.secondary_btn_link }}" class="impress-hero-btn impress-hero-btn-secondary">
            {{ section.settings.secondary_btn_text }}
          </a>
        {% endif %}
      </div>

      {% if section.settings.caption_text != blank %}
        <a href="{{ section.settings.caption_link }}" class="impress-hero-caption">
          {{ section.settings.caption_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .impress-hero-outer-wrapper {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }

  .impress-hero-card {
    background-color: var(--card-bg);
    border-radius: var(--card-radius);
    min-height: var(--card-min-height);
    padding: 60px 32px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    box-sizing: border-box;
  }

  .impress-hero-bg-image-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .impress-hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .impress-hero-overlay {
    position: absolute;
    inset: 0;
    background-color: #000000;
    opacity: var(--overlay-opacity);
  }

  .impress-hero-content {
    max-width: 800px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
    position: relative;
  }

  .impress-hero-subheading {
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--subheading-color, #ffcc00);
    margin-bottom: 16px;
  }

  .impress-hero-heading {
    font-size: 56px;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--heading-color, #ffffff);
    margin: 0 0 20px 0;
  }

  .impress-hero-description {
    font-size: 18px;
    line-height: 1.5;
    color: var(--desc-color, #a1a1aa);
    margin: 0 0 32px 0;
    max-width: 600px;
  }

  .impress-hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .impress-hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    border-radius: 50px;
    font-size: 16px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .impress-hero-btn:hover {
    transform: translateY(-2px);
  }

  .impress-hero-btn-primary {
    background-color: #ffcc00;
    color: #000000;
  }

  .impress-hero-btn-secondary {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    backdrop-filter: blur(8px);
  }

  .impress-hero-caption {
    display: inline-block;
    margin-top: 24px;
    font-size: 14px;
    font-weight: 700;
    color: #a1a1aa;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .impress-hero-caption:hover {
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .impress-hero-card {
      padding: 50px 20px;
      min-height: auto;
    }

    .impress-hero-heading {
      font-size: 36px;
    }

    .impress-hero-description {
      font-size: 16px;
    }

    .impress-hero-actions {
      width: 100%;
      flex-direction: column;
    }

    .impress-hero-btn {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Impress Hero",
  "settings": [
    {
      "type": "header",
      "content": "Card Layout & Size"
    },
    {
      "type": "range",
