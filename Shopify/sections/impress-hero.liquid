<div class="hero-wrapper" style="--hero-padding-v: {{ section.settings.vertical_padding }}px;">
  <div 
    class="hero-card" 
    style="
      --hero-radius: {{ section.settings.corner_radius }}px;
      --hero-min-height: {{ section.settings.hero_min_height }}px;
      --hero-bg: {{ section.settings.bg_color }};
      --hero-text: {{ section.settings.text_color }};
      --hero-max-width: {{ section.settings.hero_width }}px;
      --accent-yellow: {{ section.settings.accent_yellow }};
    "
  >
    <!-- Left Column: Content & 4 Action Buttons -->
    <div class="hero-content">
      {% if section.settings.subheading != blank %}
        <span class="hero-subheading">{{ section.settings.subheading }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero-heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="hero-description">{{ section.settings.description }}</div>
      {% endif %}

      <!-- 2x2 CTA Button Grid -->
      <div class="hero-btn-grid">
        {% if section.settings.btn1_label != blank %}
          <a href="{{ section.settings.btn1_url }}" class="hero-btn btn-dark">
            {{ section.settings.btn1_label }}
          </a>
        {% endif %}

        {% if section.settings.btn2_label != blank %}
          <a href="{{ section.settings.btn2_url }}" class="hero-btn btn-outline">
            {{ section.settings.btn2_label }}
          </a>
        {% endif %}

        {% if section.settings.btn3_label != blank %}
          <a href="{{ section.settings.btn3_url }}" class="hero-btn btn-yellow">
            {{ section.settings.btn3_label }}
          </a>
        {% endif %}

        {% if section.settings.btn4_label != blank %}
          <a href="{{ section.settings.btn4_url }}" class="hero-btn btn-yellow">
            {{ section.settings.btn4_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <!-- Right Column: Double Showcase Image Cards -->
    <div class="hero-media-grid">
      {% if section.settings.card_image_1 != blank %}
        <div class="hero-media-card">
          <img 
            src="{{ section.settings.card_image_1 | image_url: width: 800 }}" 
            alt="Showcase 1" 
            loading="lazy"
          >
        </div>
      {% endif %}

      {% if section.settings.card_image_2 != blank %}
        <div class="hero-media-card">
          <img 
            src="{{ section.settings.card_image_2 | image_url: width: 800 }}" 
            alt="Showcase 2" 
            loading="lazy"
          >
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
.hero-wrapper {
  width: 100%;
  padding-top: var(--hero-padding-v);
  padding-bottom: var(--hero-padding-v);
  padding-left: 20px;
  padding-right: 20px;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
}

.hero-card {
  position: relative;
  width: 100%;
  max-width: var(--hero-max-width);
  min-height: var(--hero-min-height);
  border-radius: var(--hero-radius);
  background-color: var(--hero-bg);
  color: var(--hero-text);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50px;
  box-sizing: border-box;
  gap: 40px;
}

/* LEFT CONTENT */
.hero-content {
  flex: 1 1 50%;
  max-width: 580px;
  display: flex;
  flex-direction: column;
}

.hero-subheading {
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: #1e5631; /* Accent green text */
  margin-bottom: 16px;
}

.hero-heading {
  font-size: 54px;
  font-weight: 900;
  line-height: 1.05;
  margin: 0 0 20px 0;
  color: #000000;
  letter-spacing: -1.5px;
}

.hero-description {
  font-size: 20px;
  line-height: 1.4;
  margin-bottom: 32px;
  color: #222222;
  font-weight: 500;
}

/* BUTTON GRID (2x2 Layout) */
.hero-btn-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 220px));
  gap: 12px;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 20px;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 800;
  text-decoration: none;
  text-align: center;
  white-space: nowrap;
  transition: transform 0.15s ease, opacity 0.15s ease;
  box-sizing: border-box;
}

.hero-btn:hover {
  transform: translateY(-2px);
  opacity: 0.95;
}

.btn-dark {
  background-color: #121212;
  color: #ffffff;
}

.btn-outline {
  background-color: #ffffff;
  color: #000000;
  border: 1px solid #e2e8f0;
}

.btn-yellow {
  background-color: var(--accent-yellow);
  color: #000000;
}

/* RIGHT MEDIA GRID */
.hero-media-grid {
  flex: 1 1 50%;
  display: flex;
  gap: 16px;
  justify-content: flex-end;
}

.hero-media-card {
  flex: 1;
  max-width: 270px;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  background: #ffffff;
  aspect-ratio: 3 / 4;
}

.hero-media-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

@media (max-width: 1024px) {
  .hero-card {
    flex-direction: column;
    padding: 30px;
  }
  .hero-content {
    max-width: 100%;
  }
  .hero-heading {
    font-size: 38px;
  }
  .hero-media-grid {
    width: 100%;
    justify-content: center;
  }
}

@media (max-width: 550px) {
  .hero-btn-grid {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Impress Split Hero",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Styling"
    },
    {
      "type": "range",
