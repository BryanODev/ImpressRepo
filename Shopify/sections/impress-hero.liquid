    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Button Text",
      "default": "Cotizar rotulación"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Caption Link"
    },
    {
      "type": "text",
      "id": "caption_text",
      "label": "Caption Text",
      "default": "Ver ofertas de la semana →"
