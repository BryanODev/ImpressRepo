<div 
  class="sticker-config-wrapper" 
  style="
    --padding-v: {{ section.settings.vertical_padding }}px;
    --max-width: {{ section.settings.max_width }}px;
    --bg-color: {{ section.settings.bg_color }};
    --card-bg: {{ section.settings.card_bg_color }};
    --accent-yellow: {{ section.settings.accent_yellow }};
    --text-color: {{ section.settings.text_color }};
    --text-sub: {{ section.settings.text_sub_color }};
  "
  data-section-id="{{ section.id }}"
>
  <div class="sticker-config-container">

    <!-- Header -->
    <div class="config-header">
      {% if section.settings.subheading != blank %}
        <span class="config-subheading">{{ section.settings.subheading }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="config-heading">{{ section.settings.heading }}</h1>
      {% endif %}
    </div>

    {% if product.has_only_default_variant %}

      <p class="config-no-variants">
        This product doesn't have any variants set up yet. Add options like Shape, Material and Size
        in the product admin (Variants section) to use this configurator.
      </p>

    {% else %}

    <div class="config-grid">

      <!-- Left Column: Step-by-Step Options, generated from product options -->
      <div class="config-steps-col">

        {% for option in product.options_with_values %}
          {% assign option_index = forloop.index0 %}
          {% assign grid_class = 'grid-3' %}
          {% if option.values.size <= 2 %}
            {% assign grid_class = 'grid-2' %}
          {% endif %}

          <div class="config-step-card" data-option-card data-option-index="{{ option_index }}">
            <div class="step-title-row">
              <span class="step-badge">{{ forloop.index }}</span>
              <h3 class="step-heading">{{ option.name }}</h3>
            </div>

            <div class="options-grid {{ grid_class }}">
              {% for value in option.values %}

                {% comment %} Look for a variant carrying this value that also has an image {% endcomment %}
                {% assign value_image = nil %}
                {% for variant in product.variants %}
                  {% assign variant_value = variant.options[option_index] %}
                  {% if variant_value == value and variant.featured_image %}
                    {% assign value_image = variant.featured_image %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                <label class="option-card generic-option{% if forloop.first %} active{% endif %}"
                       data-option-index="{{ option_index }}"
                       data-value="{{ value | escape }}">
                  <input type="radio"
                         name="option-{{ option_index }}"
                         value="{{ value | escape }}"
                         {% if forloop.first %}checked{% endif %}>

                  {% if value_image %}
                    <div class="option-image">
                      <img src="{{ value_image | image_url: width: 160 }}"
                           alt="{{ value | escape }}"
                           loading="lazy" width="64" height="64">
                    </div>
                  {% else %}
                    <div class="option-icon-fallback" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="9"/>
                      </svg>
                    </div>
                  {% endif %}

                  <span class="option-label">{{ value }}</span>
                </label>

              {% endfor %}
            </div>

            {% comment %}
              Optional: only render the custom-size controls under the option literally named "Size"/"Tamaño".
              If you don't want this at all, delete this whole block.
            {% endcomment %}
            {% if option.name == 'Size' or option.name == 'Tamaño' %}
              <div class="custom-size-toggle">
                <button type="button" class="btn-custom-toggle" id="ToggleCustomSize">+ Tamaño Personalizado</button>
                <div class="custom-size-inputs" id="CustomSizeContainer" style="display: none;">
                  <div class="size-input-field">
                    <label>Ancho (in)</label>
                    <input type="number" id="CustomWidth" value="2" min="1" max="12" step="0.5">
                  </div>
                  <span class="size-sep">×</span>
                  <div class="size-input-field">
                    <label>Alto (in)</label>
                    <input type="number" id="CustomHeight" value="2" min="1" max="12" step="0.5">
                  </div>
                </div>
                <p class="custom-size-note" id="CustomSizeNote" style="display: none;">
                  Los tamaños personalizados se cotizan de forma manual — nuestro equipo confirmará el precio final
                  antes de imprimir.
                </p>
              </div>
            {% endif %}
          </div>
        {% endfor %}

        <!-- Quantity & Tier Pricing (not a Shopify variant option — Shopify caps products at 3 options,
             so quantity stays as a client-side discount schedule applied on top of the selected variant's price) -->
        <div class="config-step-card">
          <div class="step-title-row">
            <span class="step-badge">{{ product.options_with_values.size | plus: 1 }}</span>
            <h3 class="step-heading">Selecciona la Cantidad</h3>
          </div>

          <div class="quantity-tiers-list" id="QuantityTiersList">
            <label class="qty-tier-row active" data-qty="50" data-discount="0">
              <input type="radio" name="sticker_qty" value="50" checked>
              <div class="qty-main-info">
                <span class="qty-count">50 unid.</span>
                <span class="qty-price-each">—</span>
              </div>
              <div class="qty-right-info">
                <span class="qty-total-price">—</span>
              </div>
            </label>

            <label class="qty-tier-row" data-qty="100" data-discount="24">
              <input type="radio" name="sticker_qty" value="100">
              <div class="qty-main-info">
                <span class="qty-count">100 unid.</span>
                <span class="qty-price-each">—</span>
                <span class="qty-savings-badge">Ahorra 24%</span>
              </div>
              <div class="qty-right-info">
                <span class="qty-total-price">—</span>
              </div>
            </label>

            <label class="qty-tier-row" data-qty="250" data-discount="48">
              <input type="radio" name="sticker_qty" value="250">
              <div class="qty-main-info">
                <span class="qty-count">250 unid.</span>
                <span class="qty-price-each">—</span>
                <span class="qty-savings-badge">Ahorra 48%</span>
              </div>
              <div class="qty-right-info">
                <span class="qty-total-price">—</span>
              </div>
            </label>

            <label class="qty-tier-row" data-qty="500" data-discount="62">
              <input type="radio" name="sticker_qty" value="500">
              <div class="qty-main-info">
                <span class="qty-count">500 unid.</span>
                <span class="qty-price-each">—</span>
                <span class="qty-savings-badge">Ahorra 62%</span>
              </div>
              <div class="qty-right-info">
                <span class="qty-total-price">—</span>
              </div>
            </label>

            <div class="extra-tiers-container" id="ExtraTiers" style="display: none;">
              <label class="qty-tier-row" data-qty="1000" data-discount="72">
                <input type="radio" name="sticker_qty" value="1000">
                <div class="qty-main-info">
                  <span class="qty-count">1,000 unid.</span>
                  <span class="qty-price-each">—</span>
                  <span class="qty-savings-badge">Ahorra 72%</span>
                </div>
                <div class="qty-right-info">
                  <span class="qty-total-price">—</span>
                </div>
              </label>

              <label class="qty-tier-row" data-qty="2500" data-discount="78">
                <input type="radio" name="sticker_qty" value="2500">
                <div class="qty-main-info">
                  <span class="qty-count">2,500 unid.</span>
                  <span class="qty-price-each">—</span>
                  <span class="qty-savings-badge">Ahorra 78%</span>
                </div>
                <div class="qty-right-info">
                  <span class="qty-total-price">—</span>
                </div>
              </label>

              <label class="qty-tier-row" data-qty="5000" data-discount="82">
                <input type="radio" name="sticker_qty" value="5000">
                <div class="qty-main-info">
                  <span class="qty-count">5,000 unid.</span>
                  <span class="qty-price-each">—</span>
                  <span class="qty-savings-badge">Ahorra 82%</span>
                </div>
                <div class="qty-right-info">
                  <span class="qty-total-price">—</span>
                </div>
              </label>
            </div>
          </div>

          <button type="button" class="btn-show-more-qty" id="ToggleMoreQty">
            Ver más cantidades ↓
          </button>
        </div>

        <!-- Upload Design -->
        <div class="config-step-card">
          <div class="step-title-row">
            <span class="step-badge">{{ product.options_with_values.size | plus: 2 }}</span>
            <h3 class="step-heading">Sube tu Arte / Diseño</h3>
          </div>

          <div class="upload-dropzone" id="DropZone">
            <input type="file" id="StickerDesignFile" accept="image/*,.pdf,.ai,.psd" style="display: none;">
            <div class="upload-content" id="UploadContent">
              <div class="upload-icon">
                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
              </div>
              <span class="upload-title">Arrastra tu archivo aquí o <button type="button" class="btn-browse" onclick="document.getElementById('StickerDesignFile').click()">busca en tu equipo</button></span>
              <span class="upload-hint">Formatos soportados: PNG, JPG, PDF, AI, PSD (Máx 50MB)</span>
            </div>

            <div class="file-preview-card" id="FilePreview" style="display: none;">
              <span class="file-name" id="FileName">mi-diseno.png</span>
              <button type="button" class="btn-remove-file" id="RemoveFile">Quitar</button>
            </div>
          </div>
          <p class="upload-note">
            Nota: la subida de archivos aquí es solo para previsualización local. Para adjuntar el archivo real al
            pedido necesitas una app de "custom file upload" (o un campo de tipo archivo en el checkout) — este
            script no lo envía a ningún servidor todavía.
          </p>
        </div>

      </div>

      <!-- Right Column: Sticky Live Order Summary -->
      <div class="config-summary-col">
        <div class="summary-sticky-card">
          <h3 class="summary-heading">Resumen de tu Pedido</h3>

          <div class="summary-details" id="SummaryDetails">
            <div class="summary-row">
              <span>Producto:</span>
              <strong>{{ product.title }}</strong>
            </div>

            {% for option in product.options_with_values %}
              <div class="summary-row">
                <span>{{ option.name }}:</span>
                <strong data-summary-option="{{ forloop.index0 }}">{{ option.values.first }}</strong>
              </div>
            {% endfor %}

            <div class="summary-row">
              <span>Cantidad:</span>
              <strong id="SummaryQty">50 unid.</strong>
            </div>
            <div class="summary-row">
              <span>Precio Unitario:</span>
              <strong id="SummaryUnitPrice">{{ product.price | money }}</strong>
            </div>
          </div>

          <div class="summary-divider"></div>

          <div class="summary-total-box">
            <span>Total Estimado:</span>
            <span class="summary-total-price" id="SummaryTotal">{{ product.price | money }}</span>
          </div>

          <p class="summary-unavailable" id="SummaryUnavailable" style="display: none;">
            Esta combinación no está disponible.
          </p>

          <button type="button" class="btn-submit-order" id="BtnSubmitOrder">
            Añadir al Carrito — <span id="BtnPrice">{{ product.price | money }}</span>
          </button>

          <div class="summary-guarantees">
            <span>✓ Prueba digital enviada antes de imprimir</span>
            <span>✓ Envío rápido o recogida disponible</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Raw variant data for the JS below. Kept as JSON so nothing here needs hardcoding -->
    <script type="application/json" id="ConfiguratorVariantData-{{ section.id }}">
      {
        "moneyFormat": {{ shop.money_format | json }},
        "optionCount": {{ product.options_with_values.size }},
        "variants": [
          {% for variant in product.variants %}
            {
              "id": {{ variant.id | json }},
              "available": {{ variant.available | json }},
              "price": {{ variant.price | json }},
              "options": {{ variant.options | json }},
              "title": {{ variant.title | json }},
              "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 200 | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    </script>

    {% endif %}

  </div>
</div>

<script>
(function() {
  var sectionId = {{ section.id | json }};
  var dataEl = document.getElementById('ConfiguratorVariantData-' + sectionId);
  if (!dataEl) return; // no variants — nothing to wire up

  var data = JSON.parse(dataEl.textContent);
  var variants = data.variants;
  var optionCount = data.optionCount;

  // selectedOptions[i] = currently chosen value for option index i
  var selectedOptions = [];
  for (var i = 0; i < optionCount; i++) {
    var checkedInput = document.querySelector('input[name="option-' + i + '"]:checked');
    selectedOptions[i] = checkedInput ? checkedInput.value : null;
  }

  function findMatchingVariant() {
    for (var v = 0; v < variants.length; v++) {
      var variant = variants[v];
      var isMatch = true;
      for (var i = 0; i < optionCount; i++) {
        if (variant.options[i] !== selectedOptions[i]) {
          isMatch = false;
          break;
        }
      }
      if (isMatch) return variant;
    }
    return null;
  }

  function formatMoney(cents) {
    // Simple fallback formatter; swap for Shopify.formatMoney(data.moneyFormat) if you load money.js
    return '$' + (cents / 100).toFixed(2);
  }

  var qtyTiers = Array.prototype.slice.call(document.querySelectorAll('.qty-tier-row'));

  function getActiveQtyTier() {
    return document.querySelector('.qty-tier-row.active') || qtyTiers[0];
  }

  function updateAll() {
    var variant = findMatchingVariant();
    var submitBtn = document.getElementById('BtnSubmitOrder');
    var unavailableMsg = document.getElementById('SummaryUnavailable');

    // Update summary column values for each option
    for (var i = 0; i < optionCount; i++) {
      var summaryEl = document.querySelector('[data-summary-option="' + i + '"]');
      if (summaryEl) summaryEl.textContent = selectedOptions[i];
    }

    if (!variant || !variant.available) {
      if (submitBtn) { submitBtn.disabled = true; submitBtn.classList.add('is-disabled'); }
      if (unavailableMsg) unavailableMsg.style.display = 'block';
      qtyTiers.forEach(function(row) {
        row.querySelector('.qty-price-each').textContent = '—';
        row.querySelector('.qty-total-price').textContent = '—';
      });
      document.getElementById('SummaryUnitPrice').textContent = '—';
      document.getElementById('SummaryTotal').textContent = '—';
      document.getElementById('BtnPrice').textContent = '—';
      return;
    }

    if (submitBtn) { submitBtn.disabled = false; submitBtn.classList.remove('is-disabled'); }
    if (unavailableMsg) unavailableMsg.style.display = 'none';

    var basePrice = variant.price; // cents, at the qty-50 baseline

    // Recompute every tier row's displayed price against this variant's real price
    qtyTiers.forEach(function(row) {
      var qty = parseInt(row.getAttribute('data-qty'), 10);
      var discount = parseInt(row.getAttribute('data-discount'), 10) || 0;
      var unitCents = Math.round(basePrice * (1 - discount / 100));
      var totalCents = unitCents * qty;
      row.querySelector('.qty-price-each').textContent = formatMoney(unitCents) + ' c/u';
      row.querySelector('.qty-total-price').textContent = formatMoney(totalCents);
      row.dataset.unitPrice = unitCents;
      row.dataset.total = totalCents;
    });

    var activeTier = getActiveQtyTier();
    var activeTotal = parseInt(activeTier.dataset.total, 10);
    var activeUnit = parseInt(activeTier.dataset.unitPrice, 10);

    document.getElementById('SummaryUnitPrice').textContent = formatMoney(activeUnit);
    document.getElementById('SummaryTotal').textContent = formatMoney(activeTotal);
    document.getElementById('BtnPrice').textContent = formatMoney(activeTotal);
    document.getElementById('SummaryQty').textContent =
      activeTier.querySelector('input').value + ' unid.';

    submitBtn.dataset.variantId = variant.id;
    submitBtn.dataset.quantity = activeTier.querySelector('input').value;
  }

  // Option card clicks
  document.querySelectorAll('.generic-option').forEach(function(card) {
    card.addEventListener('click', function() {
      var idx = parseInt(card.getAttribute('data-option-index'), 10);
      var group = document.querySelectorAll('.generic-option[data-option-index="' + idx + '"]');
      group.forEach(function(c) { c.classList.remove('active'); });
      card.classList.add('active');
      card.querySelector('input[type="radio"]').checked = true;
      selectedOptions[idx] = card.getAttribute('data-value');
      updateAll();
    });
  });

  // Quantity tier clicks
  qtyTiers.forEach(function(row) {
    row.addEventListener('click', function() {
      qtyTiers.forEach(function(r) { r.classList.remove('active'); });
      row.classList.add('active');
      row.querySelector('input').checked = true;
      updateAll();
    });
  });

  // Show/hide extra quantity tiers
  var btnMoreQty = document.getElementById('ToggleMoreQty');
  var extraTiers = document.getElementById('ExtraTiers');
  if (btnMoreQty && extraTiers) {
    btnMoreQty.addEventListener('click', function() {
      var isHidden = extraTiers.style.display === 'none';
      extraTiers.style.display = isHidden ? 'block' : 'none';
      btnMoreQty.innerText = isHidden ? 'Ver menos cantidades ↑' : 'Ver más cantidades ↓';
    });
  }

  // Custom size toggle (only present if an option is literally named Size/Tamaño)
  var toggleCustomBtn = document.getElementById('ToggleCustomSize');
  var customSizeContainer = document.getElementById('CustomSizeContainer');
  var customSizeNote = document.getElementById('CustomSizeNote');
  if (toggleCustomBtn && customSizeContainer) {
    toggleCustomBtn.addEventListener('click', function() {
      var isHidden = customSizeContainer.style.display === 'none';
      customSizeContainer.style.display = isHidden ? 'flex' : 'none';
      if (customSizeNote) customSizeNote.style.display = isHidden ? 'block' : 'none';
      toggleCustomBtn.innerText = isHidden ? '- Usar tamaños predeterminados' : '+ Tamaño Personalizado';
    });
  }

  // File upload preview (local only — see note in markup about real uploads)
  var fileInput = document.getElementById('StickerDesignFile');
  var uploadContent = document.getElementById('UploadContent');
  var filePreview = document.getElementById('FilePreview');
  var fileNameSpan = document.getElementById('FileName');
  var removeFileBtn = document.getElementById('RemoveFile');

  if (fileInput) {
    fileInput.addEventListener('change', function(e) {
      if (e.target.files.length > 0) {
        fileNameSpan.innerText = e.target.files[0].name;
        uploadContent.style.display = 'none';
        filePreview.style.display = 'flex';
      }
    });
    removeFileBtn.addEventListener('click', function() {
      fileInput.value = '';
      uploadContent.style.display = 'flex';
      filePreview.style.display = 'none';
    });
  }

  // Add to cart
  var submitBtn = document.getElementById('BtnSubmitOrder');
  if (submitBtn) {
    submitBtn.addEventListener('click', function() {
      if (submitBtn.disabled) return;
      var variantId = submitBtn.dataset.variantId;
      var quantity = submitBtn.dataset.quantity || 1;

      var properties = {};
      if (customSizeContainer && customSizeContainer.style.display !== 'none') {
        var w = document.getElementById('CustomWidth').value;
        var h = document.getElementById('CustomHeight').value;
        properties['Tamaño Personalizado'] = w + '" x ' + h + '"';
      }
      if (fileNameSpan && filePreview.style.display !== 'none') {
        properties['Archivo de Diseño'] = fileNameSpan.innerText;
      }

      submitBtn.disabled = true;
      submitBtn.classList.add('is-loading');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: variantId,
          quantity: quantity,
          properties: properties
        })
      })
        .then(function(res) { return res.json(); })
        .then(function() {
          submitBtn.classList.remove('is-loading');
          submitBtn.disabled = false;
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          window.location.href = '/cart';
        })
        .catch(function(err) {
          console.error('Add to cart failed:', err);
          submitBtn.classList.remove('is-loading');
          submitBtn.disabled = false;
          alert('No pudimos agregar el producto al carrito. Intenta de nuevo.');
        });
    });
  }

  updateAll();
})();
</script>

{% stylesheet %}
.sticker-config-wrapper {
  width: 100%;
  background-color: var(--bg-color);
  padding-top: var(--padding-v);
  padding-bottom: var(--padding-v);
  padding-left: 20px;
  padding-right: 20px;
  box-sizing: border-box;
  color: var(--text-color);
}

.sticker-config-container {
  max-width: var(--max-width);
  margin: 0 auto;
}

.config-no-variants {
  background-color: rgba(255, 204, 0, 0.08);
  border: 1px solid rgba(255, 204, 0, 0.3);
  border-radius: 12px;
  padding: 16px 20px;
  color: var(--text-color);
}

.config-subheading {
  display: block;
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--accent-yellow);
  margin-bottom: 8px;
}

.config-heading {
  font-size: 42px;
  font-weight: 900;
  letter-spacing: -1px;
  margin: 0 0 40px 0;
}

/* GRID LAYOUT */
.config-grid {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 32px;
  align-items: start;
}

.config-summary-col {
  height: 100%;
  position: relative;
}

/* CARDS & STEPS */
.config-steps-col {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.config-step-card {
  background-color: var(--card-bg);
  border-radius: 20px;
  padding: 28px;
  box-sizing: border-box;
}

.step-title-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.step-badge {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: var(--accent-yellow);
  color: #000000;
  font-size: 15px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-heading {
  font-size: 20px;
  font-weight: 800;
  margin: 0;
}

/* OPTION GRIDS */
.options-grid {
  display: grid;
  gap: 12px;
}

.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-2 { grid-template-columns: repeat(2, 1fr); }

.option-card {
  border: 2px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  padding: 16px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background-color: rgba(255, 255, 255, 0.02);
  transition: all 0.2s ease;
  user-select: none;
}

.option-card input[type="radio"] {
  display: none;
}

.option-card:hover {
  border-color: rgba(255, 255, 255, 0.3);
}

.option-card.active {
  border-color: var(--accent-yellow);
  background-color: rgba(255, 204, 0, 0.06);
}

.option-image {
  margin-bottom: 8px;
  width: 64px;
  height: 64px;
  border-radius: 10px;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.04);
}

.option-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.option-icon-fallback {
  margin-bottom: 4px;
  color: var(--text-sub);
}

.option-label {
  font-size: 15px;
  font-weight: 800;
}

/* CUSTOM SIZE INPUTS */
.custom-size-toggle {
  margin-top: 16px;
}

.btn-custom-toggle {
  background: none;
  border: none;
  color: var(--accent-yellow);
  font-weight: 700;
  cursor: pointer;
  padding: 0;
  font-size: 14px;
}

.custom-size-inputs {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
}

.custom-size-note {
  font-size: 12px;
  color: var(--text-sub);
  margin-top: 10px;
  margin-bottom: 0;
}

.size-input-field {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.size-input-field label {
  font-size: 12px;
  color: var(--text-sub);
}

.size-input-field input {
  width: 90px;
  background-color: rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  color: #ffffff;
  padding: 10px;
  font-size: 15px;
  font-weight: 700;
}

.size-sep {
  font-size: 18px;
  margin-top: 18px;
  color: var(--text-sub);
}

/* QUANTITY TIERS */
.quantity-tiers-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.qty-tier-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 14px 18px;
  cursor: pointer;
  background-color: rgba(255, 255, 255, 0.02);
  transition: all 0.2s ease;
}

.qty-tier-row input { display: none; }

.qty-tier-row:hover {
  border-color: rgba(255, 255, 255, 0.2);
}

.qty-tier-row.active {
  border-color: var(--accent-yellow);
  background-color: rgba(255, 204, 0, 0.06);
}

.qty-main-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.qty-count {
  font-size: 16px;
  font-weight: 800;
}

.qty-price-each {
  font-size: 13px;
  color: var(--text-sub);
}

.qty-savings-badge {
  background-color: #16a34a;
  color: #ffffff;
  font-size: 11px;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 20px;
}

.qty-total-price {
  font-size: 16px;
  font-weight: 800;
}

.btn-show-more-qty {
  width: 100%;
  background: none;
  border: 1px dashed rgba(255, 255, 255, 0.2);
  color: var(--text-color);
  padding: 12px;
  border-radius: 10px;
  font-weight: 700;
  margin-top: 12px;
  cursor: pointer;
  transition: background 0.2s ease;
}

.btn-show-more-qty:hover {
  background-color: rgba(255, 255, 255, 0.05);
}

/* FILE UPLOAD DROPZONE */
.upload-dropzone {
  border: 2px dashed rgba(255, 255, 255, 0.2);
  border-radius: 14px;
  padding: 28px;
  text-align: center;
  background-color: rgba(0, 0, 0, 0.2);
}

.upload-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.upload-title {
  font-size: 15px;
  font-weight: 700;
}

.upload-note {
  font-size: 12px;
  color: var(--text-sub);
  margin-top: 12px;
  margin-bottom: 0;
}

.btn-browse {
  background: none;
  border: none;
  color: var(--accent-yellow);
  text-decoration: underline;
  font-weight: 800;
  cursor: pointer;
}

.upload-hint {
  font-size: 12px;
  color: var(--text-sub);
}

.file-preview-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: rgba(255, 255, 255, 0.08);
  padding: 12px 16px;
  border-radius: 8px;
}

.btn-remove-file {
  background: none;
  border: none;
  color: #ef4444;
  font-weight: 800;
  cursor: pointer;
}

/* RIGHT SUMMARY CARD */
.summary-sticky-card {
  position: -webkit-sticky;
  position: sticky;
  top: 30px;
  background-color: var(--card-bg);
  border-radius: 20px;
  padding: 28px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: top 0.1s ease-out;
  will-change: position, top;
}

.summary-heading {
  font-size: 22px;
  font-weight: 900;
  margin: 0 0 20px 0;
}

.summary-details {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  gap: 12px;
}

.summary-row span {
  color: var(--text-sub);
}

.summary-row strong {
  text-align: right;
}

.summary-divider {
  height: 1px;
  background-color: rgba(255, 255, 255, 0.1);
  margin: 20px 0;
}

.summary-total-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  font-size: 16px;
  font-weight: 800;
}

.summary-total-price {
  font-size: 28px;
  font-weight: 900;
  color: var(--accent-yellow);
}

.summary-unavailable {
  color: #ef4444;
  font-size: 13px;
  font-weight: 700;
  margin: 0 0 12px 0;
}

.btn-submit-order {
  width: 100%;
  background-color: var(--accent-yellow);
  color: #000000;
  border: none;
  padding: 18px;
  border-radius: 50px;
  font-size: 16px;
  font-weight: 900;
  cursor: pointer;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn-submit-order:hover {
  transform: translateY(-2px);
}

.btn-submit-order.is-disabled,
.btn-submit-order:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.btn-submit-order.is-loading {
  opacity: 0.7;
}

.summary-guarantees {
  margin-top: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 12px;
  color: var(--text-sub);
}

/* RESPONSIVE */
@media (max-width: 960px) {
  .config-grid {
    grid-template-columns: 1fr;
  }
  .grid-3 {
    grid-template-columns: 1fr;
  }
  .grid-2 {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Sticker Configurator",
  "settings": [
    {
      "type": "header",
      "content": "Header & Colors"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CONFIGURADOR DE IMPRESIÓN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stickers en Vinilo Personalizados"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0e1117"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#161b22"
    },
    {
      "type": "color",
      "id": "accent_yellow",
      "label": "Accent Yellow",
      "default": "#ffcc00"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_sub_color",
      "label": "Secondary Text Color",
      "default": "#9198a1"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1240
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top & Bottom Spacing",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Sticker Configurator"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
