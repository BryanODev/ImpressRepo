/*
 * IMPRESS storefront layout. Editable in Shopify Theme Editor.
 */
{
  "sections": {
    "main": {
      "type": "impress-all-products",
      "settings": {
        "heading": "Todo lo que puedes imprimir",
        "description": "Explora nuestros productos, encuentra lo que necesitas y personaliza tu pedido en línea."
      }
    },
    "general_faq": {
      "type": "impress-home-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "¿Cómo hago un pedido?",
            "answer": "Elige tu producto, selecciona las opciones disponibles y añade tu diseño o servicio de arte antes de completar el carrito."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "¿Puedo pedir que preparen el diseño?",
            "answer": "Si el producto ofrece el servicio de diseño, podrás añadirlo durante la configuración. El costo aparecerá antes de pagar."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "¿Cómo elijo tamaño y cantidad?",
            "answer": "Selecciona entre las medidas y paquetes disponibles en el configurador de cada producto."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "¿Puedo enviar mi propio arte?",
            "answer": "Sí. Adjunta tu archivo desde la página del producto y revisa la vista previa antes de ordenar."
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "¿Cómo sé cuánto tarda?",
            "answer": "Los tiempos dependen del tipo de producto y la cantidad. Si tienes una fecha límite, consúltanos antes de ordenar."
          }
        }
      },
      "block_order": [
        "faq_1",
        "faq_2",
        "faq_3",
        "faq_4",
        "faq_5"
      ],
      "settings": {
        "eyebrow": "PREGUNTAS FRECUENTES",
        "heading": "Preguntas sobre tus pedidos",
        "description": "Te ayudamos a escoger el producto adecuado.",
        "contact_label": "Contáctanos",
        "max_width": 1240,
        "padding_top": 55,
        "padding_bottom": 60,
        "bg_color": "#111216",
        "accent_color": "#fbbf00"
      }
    },
    "journal": {
      "type": "impress-home-blog",
      "settings": {
        "eyebrow": "BLOG IMPRESS",
        "heading": "Ideas y consejos para imprimir mejor",
        "description": "Guías, materiales e inspiración para tu próximo proyecto.",
        "button_label": "Ver artículos",
        "limit": 3,
        "max_width": 1240,
        "bg_color": "#f7f8f9",
        "accent_color": "#fbbf00"
      }
    }
  },
  "order": [
    "main",
    "general_faq",
    "journal"
  ]
