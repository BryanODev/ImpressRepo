          "type": "faq_item",
          "settings": {
            "question": "¿Cómo hago un pedido?",
            "answer": "Elige tu producto, selecciona las opciones disponibles y añade tu diseño o servicio de arte antes de completar el carrito."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "¿Puedo pedir que preparen el diseño?",
            "answer": "Si el producto ofrece el servicio de diseño, podrás añadirlo durante la configuración. El costo aparecerá antes de pagar."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "¿Cómo elijo tamaño y cantidad?",
            "answer": "Selecciona entre las medidas y paquetes disponibles en el configurador de cada producto."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "¿Puedo enviar mi propio arte?",
            "answer": "Sí. Adjunta tu archivo desde la página del producto y revisa la vista previa antes de ordenar."
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "¿Cómo sé cuánto tarda?",
            "answer": "Los tiempos dependen del tipo de producto y la cantidad. Si tienes una fecha límite, consúltanos antes de ordenar."
          }
        }
