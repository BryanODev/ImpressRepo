{% render 'impress-paper-configurator', paper_product: product, paper_type: 'businessCards', paper_section_id: section.id, paper_title: section.settings.heading, paper_subtitle: section.settings.subtitle %}
{% schema %}
{
  "name":"Impress Business Cards",
  "tag":"section",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"text","id":"heading","label":"Título","default":"Tarjetas de presentación personalizadas"},
    {"type":"text","id":"subtitle","label":"Subtítulo","default":"Diseña frente y dorso, elige orientación y revisa antes de ordenar."}
  ],
  "presets":[{"name":"Impress Business Cards"}]
}
{% endschema %}
