
<div class="impress-benefits" style="
  --benefits-bg: {{ section.settings.bg_color }};
  --benefits-card-bg: {{ section.settings.card_bg }};
  --benefits-accent: {{ section.settings.accent_color }};
  --benefits-padding-top: {{ section.settings.padding_top }}px;
  --benefits-padding-bottom: {{ section.settings.padding_bottom }}px;
  --benefits-max: {{ section.settings.max_width }}px;
">
  <div class="impress-benefits__container">
    <div class="impress-benefits__header">
      {% if section.settings.subheading != blank %}<p class="impress-benefits__eyebrow">{{ section.settings.subheading }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="impress-benefits__title">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.description != blank %}<p class="impress-benefits__description">{{ section.settings.description }}</p>{% endif %}
    </div>
    <div class="impress-benefits__grid">
      {% for block in section.blocks %}
        <div class="impress-benefits__card" {{ block.shopify_attributes }}>
          <div class="impress-benefits__icon">{{ block.settings.badge_text | default: forloop.index }}</div>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% stylesheet %}
.impress-benefits { background: var(--benefits-bg); padding: var(--benefits-padding-top) 20px var(--benefits-padding-bottom); }
.impress-benefits__container { max-width: var(--benefits-max); margin: 0 auto; }
.impress-benefits__header { max-width: 720px; margin-bottom: 28px; }
.impress-benefits__eyebrow { margin: 0 0 10px; color: var(--benefits-accent); font-size: 12px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; }
.impress-benefits__title { margin: 0 0 12px; font-size: clamp(30px, 3vw, 42px); line-height: 1.05; letter-spacing: -.03em; font-weight: 900; color: #101114; }
.impress-benefits__description { margin: 0; font-size: 16px; line-height: 1.6; color: #61646c; }
.impress-benefits__grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 18px; }
.impress-benefits__card { background: var(--benefits-card-bg); border-radius: 22px; padding: 24px; border: 1px solid #e8ebef; box-shadow: 0 10px 26px rgba(0,0,0,.05); }
.impress-benefits__icon { width: 42px; height: 42px; border-radius: 999px; background: var(--benefits-accent); color: #121212; font-weight: 900; display: flex; align-items: center; justify-content: center; margin-bottom: 18px; }
.impress-benefits__card h3 { margin: 0 0 10px; font-size: 19px; line-height: 1.15; color: #101114; }
.impress-benefits__card p { margin: 0; font-size: 14px; line-height: 1.55; color: #666b75; }
@media (max-width: 989px) { .impress-benefits__grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
@media (max-width: 768px) { .impress-benefits { padding-left: 16px; padding-right: 16px; } .impress-benefits__grid { grid-template-columns: 1fr; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Impress Home Benefits",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Por qué Impress" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Impresión rápida, clara y lista para ordenar." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Diseñamos la página para que el cliente entienda rápido qué ordenar y cómo completar su pedido." },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 900, "max": 1440, "step": 20, "unit": "px", "default": 1240 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#fbbf00" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "badge_text", "label": "Badge text", "default": "01" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Proceso claro" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "El cliente elige producto, medidas y termina su pedido sin confusión." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Impress Home Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "badge_text": "01", "heading": "Ordena sin fricción", "description": "Menos pasos, más claridad y una mejor experiencia desde el inicio." } },
        { "type": "benefit", "settings": { "badge_text": "02", "heading": "Producción rápida", "description": "Responde rápido a clientes que necesitan stickers, banners y piezas impresas." } },
        { "type": "benefit", "settings": { "badge_text": "03", "heading": "Sube tu diseño", "description": "Cada producto acepta arte listo para producir con una vista previa clara." } },
        { "type": "benefit", "settings": { "badge_text": "04", "heading": "Soporte local", "description": "Atiende empresas en Puerto Rico con recogido, envío y servicio directo." } }
      ]
    }
  ]
}
{% endschema %}
