{% if section.blocks.size > 0 %}
<section class="impress-reviews" style="--ir-accent:{{ section.settings.accent_color }};--ir-bg:{{ section.settings.bg_color }};--ir-max:{{ section.settings.max_width }}px">
  <div class="impress-reviews__inner">
    <p class="impress-reviews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.description != blank %}<p class="impress-reviews__description">{{ section.settings.description | escape }}</p>{% endif %}
    <div class="impress-reviews__grid">
      {% for block in section.blocks %}
        {% if block.settings.quote != blank and block.settings.author != blank %}
          <figure class="impress-reviews__card" {{ block.shopify_attributes }}>
            {% if block.settings.stars > 0 %}<div class="impress-reviews__stars" aria-label="{{ block.settings.stars }} de 5 estrellas">{% for i in (1..block.settings.stars) %}★{% endfor %}</div>{% endif %}
            <blockquote>{{ block.settings.quote | escape | newline_to_br }}</blockquote>
            <figcaption><strong>{{ block.settings.author | escape }}</strong>{% if block.settings.context != blank %}<span>{{ block.settings.context | escape }}</span>{% endif %}</figcaption>
          </figure>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% elsif request.design_mode %}
  <div style="padding:22px;background:#f4f4f4;text-align:center;color:#333">Impress Reseñas: añade reseñas auténticas como bloques. Se ocultará hasta que agregues contenido real.</div>
{% endif %}
{% stylesheet %}
.impress-reviews{background:var(--ir-bg,#f7f8f9);padding:70px 20px;font-family:system-ui,sans-serif}
.impress-reviews__inner{max-width:var(--ir-max,1240px);margin:auto}
.impress-reviews__eyebrow{font-size:12px;font-weight:900;letter-spacing:1.3px;text-transform:uppercase;color:#957000;margin:0 0 12px}
.impress-reviews h2{font-size:clamp(32px,3vw,44px);letter-spacing:-.035em;line-height:1.08;color:#14171b;margin:0 0 12px}
.impress-reviews__description{color:#656a73;margin:0 0 30px;line-height:1.55}
.impress-reviews__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.impress-reviews__card{background:white;border:1px solid #e4e6e9;border-radius:20px;margin:0;padding:26px;box-shadow:0 9px 30px #0000000a}
.impress-reviews__stars{color:#d29c00;letter-spacing:3px;font-size:20px;margin-bottom:20px}
.impress-reviews__card blockquote{font-size:16px;line-height:1.6;font-weight:550;color:#252a30;margin:0 0 25px}
.impress-reviews__card figcaption{display:flex;flex-direction:column;gap:3px;font-size:13px;color:#646973}
.impress-reviews__card figcaption strong{font-size:15px;color:#16191e}
@media(max-width:780px){.impress-reviews__grid{grid-template-columns:1fr}.impress-reviews{padding:52px 16px}}
{% endstylesheet %}
{% schema %}
{
  "name":"Impress Reviews",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Etiqueta","default":"OPINIONES DE CLIENTES"},
    {"type":"text","id":"heading","label":"Título","default":"Lo que dicen nuestros clientes"},
    {"type":"textarea","id":"description","label":"Descripción","default":"Experiencias compartidas por clientes de Impress."},
    {"type":"range","id":"max_width","label":"Ancho","min":900,"max":1440,"step":20,"default":1240},
    {"type":"color","id":"bg_color","label":"Fondo","default":"#f7f8f9"},
    {"type":"color","id":"accent_color","label":"Acento","default":"#fbbf00"}
  ],
  "blocks":[{"type":"review","name":"Reseña verificada","settings":[
    {"type":"textarea","id":"quote","label":"Reseña real"},
    {"type":"text","id":"author","label":"Nombre del cliente"},
    {"type":"text","id":"context","label":"Empresa o detalle (opcional)"},
    {"type":"range","id":"stars","label":"Estrellas (si es valoración real)","min":0,"max":5,"step":1,"default":0}
  ]}],
  "presets":[{"name":"Impress Reviews"}]
}
{% endschema %}
