{% liquid
  assign visible_reviews = 0
  assign app_block_count = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_block_count = app_block_count | plus: 1
    elsif block.type == 'review'
      assign review_author = block.settings.author | strip
      assign review_quote = block.settings.quote | strip
      assign review_stars = block.settings.stars | plus: 0
      assign rating_type = block.settings.rating_type | default: 'stars'
      if review_author != blank and review_quote != blank
        if rating_type == 'recommended'
          assign visible_reviews = visible_reviews | plus: 1
        elsif review_stars > 0
          if section.settings.only_five_stars == false or review_stars == 5
            assign visible_reviews = visible_reviews | plus: 1
          endif
        endif
      endif
    endif
  endfor
%}

{% if visible_reviews > 0 or app_block_count > 0 %}
  <section class="impress-reviews" style="--ir-accent: {{ section.settings.accent_color }}; --ir-bg: {{ section.settings.bg_color }}; --ir-max: {{ section.settings.max_width }}px" aria-labelledby="reviews-title-{{ section.id }}">
    <div class="impress-reviews__inner">
      <div class="impress-reviews__heading">
        {% if section.settings.eyebrow != blank %}
          <p class="impress-reviews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 id="reviews-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <p class="impress-reviews__description">{{ section.settings.description | escape }}</p>
        {% endif %}
        {% if section.settings.only_five_stars and visible_reviews > 0 %}
          <p class="impress-reviews__filter-note">Selección de reseñas de 5 estrellas y recomendaciones positivas.</p>
        {% endif %}
      </div>

      {% if visible_reviews > 0 %}
        <div class="impress-reviews__grid">
          {% for block in section.blocks %}
            {% if block.type == 'review' %}
              {% liquid
                assign review_author = block.settings.author | strip
                assign review_quote = block.settings.quote | strip
                assign review_stars = block.settings.stars | plus: 0
                assign rating_type = block.settings.rating_type | default: 'stars'
                assign review_source = block.settings.source | default: 'other'
                assign should_show = false
                if review_author != blank and review_quote != blank
                  if rating_type == 'recommended'
                    assign should_show = true
                  elsif review_stars > 0
                    if section.settings.only_five_stars == false or review_stars == 5
                      assign should_show = true
                    endif
                  endif
                endif
              %}
              {% if should_show %}
                <figure class="impress-reviews__card" {{ block.shopify_attributes }}>
                  <div class="impress-reviews__card-top">
                    {% if rating_type == 'recommended' %}
                      <div class="impress-reviews__recommended" aria-label="Recomendación positiva">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v12H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h3Zm0 0 5-8c2-1 3 0 3 2v4h5c2 0 3 1 2 3l-2 9c0 1-1 2-3 2H7"/></svg>
                        <span>Recomienda</span>
                      </div>
                    {% else %}
                      <div class="impress-reviews__rating" aria-label="{{ review_stars }} de 5 estrellas">
                        <span class="impress-reviews__stars" aria-hidden="true">
                          {% for star in (1..5) %}<span{% if star > review_stars %} class="is-empty"{% endif %}>★</span>{% endfor %}
                        </span>
                        <span class="impress-reviews__rating-number">{{ review_stars }}/5</span>
                      </div>
                    {% endif %}
                    <span class="impress-reviews__source impress-reviews__source--{{ review_source | escape }}">
                      {% case review_source %}
                        {% when 'google' %}<span class="impress-reviews__source-mark" aria-hidden="true">G</span> Google
                        {% when 'facebook' %}<span class="impress-reviews__source-mark" aria-hidden="true">f</span> Facebook
                        {% else %}Cliente
                      {% endcase %}
                    </span>
                  </div>

                  <blockquote class="impress-reviews__quote">“{{ review_quote | escape | newline_to_br }}”</blockquote>
                  <figcaption class="impress-reviews__footer">
                    <div class="impress-reviews__person">
                      {% if block.settings.avatar != blank %}
                        {{ block.settings.avatar | image_url: width: 96 | image_tag: width: 44, height: 44, loading: 'lazy', alt: '', class: 'impress-reviews__avatar' }}
                      {% else %}
                        <span class="impress-reviews__initial" aria-hidden="true">{{ review_author | slice: 0, 1 | upcase }}</span>
                      {% endif %}
                      <span class="impress-reviews__person-text">
                        <strong>{{ review_author | escape }}</strong>
                        {% if block.settings.context != blank %}
                          <span>{{ block.settings.context | escape }}</span>
                        {% endif %}
                      </span>
                    </div>
                    {% if block.settings.review_url != blank %}
                      <a class="impress-reviews__original" href="{{ block.settings.review_url }}" target="_blank" rel="noopener noreferrer">
                        Ver reseña original <span aria-hidden="true">↗</span>
                      </a>
                    {% endif %}
                  </figcaption>
                </figure>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if app_block_count > 0 %}
        <div class="impress-reviews__app-widgets">
          {% for block in section.blocks %}
            {% if block.type == '@app' %}
              {% render block %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
{% elsif request.design_mode %}
  <div class="impress-reviews__editor-empty" role="note">
    <strong>Reseñas de clientes</strong>
    Agrega reseñas auténticas con nombre, comentario, calificación y fuente (Google/Facebook), o añade un bloque de una aplicación de reseñas conectada a tus cuentas. No se muestran reseñas inventadas.
  </div>
{% endif %}

{% stylesheet %}
.impress-reviews{background:var(--ir-bg,#f7f8f9);padding:72px 20px;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
.impress-reviews *{box-sizing:border-box}
.impress-reviews__inner{max-width:var(--ir-max,1240px);margin:0 auto}
.impress-reviews__heading{max-width:800px;margin:0 0 30px}
.impress-reviews__eyebrow{font-size:12px;font-weight:850;letter-spacing:1.5px;text-transform:uppercase;color:#888888;margin:0 0 11px}
.impress-reviews h2{font-size:clamp(30px,3.4vw,46px);letter-spacing:-.04em;line-height:1.1;font-weight:850;color:#111111;margin:0 0 12px}
.impress-reviews__description{color:#646973;font-size:15px;line-height:1.6;margin:0}
.impress-reviews__filter-note{font-size:12px;color:#888888;margin:12px 0 0;line-height:1.5}
.impress-reviews__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.impress-reviews__card{min-width:0;display:flex;flex-direction:column;background:#ffffff;border:1px solid #e4e7ea;border-radius:20px;margin:0;padding:24px;box-shadow:0 9px 30px rgba(12,15,18,.045)}
.impress-reviews__card-top{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:19px}
.impress-reviews__rating{display:flex;align-items:center;gap:9px;white-space:nowrap}
.impress-reviews__stars{display:inline-flex;gap:1px;color:var(--ir-accent,#fbbf00);font-size:20px;line-height:1;letter-spacing:0}
.impress-reviews__stars .is-empty{color:#dadde1}
.impress-reviews__rating-number{font-size:12px;font-weight:800;color:#111111;font-variant-numeric:tabular-nums}
.impress-reviews__recommended{display:flex;align-items:center;gap:7px;color:#111111;font-size:13px;font-weight:800}
.impress-reviews__recommended svg{color:#fbbf00}
.impress-reviews__source{display:inline-flex;align-items:center;gap:6px;border-radius:99px;padding:6px 10px;font-size:11px;font-weight:800;line-height:1.3;background:#f4f5f6;color:#363b42;white-space:nowrap}
.impress-reviews__source-mark{font-size:14px;line-height:1;font-weight:850}
.impress-reviews__source--google .impress-reviews__source-mark{color:#4285f4}
.impress-reviews__source--facebook .impress-reviews__source-mark{color:#1877f2;font-family:Arial,sans-serif}
.impress-reviews__quote{flex:1 1 auto;font-size:16px;line-height:1.65;font-weight:500;color:#262a30;margin:0 0 28px;overflow-wrap:anywhere}
.impress-reviews__footer{display:flex;flex-direction:column;gap:12px;margin-top:auto;border-top:1px solid #eef0f2;padding-top:17px}
.impress-reviews__person{display:flex;gap:11px;align-items:center;min-width:0}
.impress-reviews__initial,.impress-reviews__avatar{width:44px;height:44px;flex:0 0 44px;border-radius:50%;object-fit:cover}
.impress-reviews__initial{display:grid;place-items:center;background:#fff4ca;border:1px solid #ffea9c;color:#111111;font-size:17px;font-weight:800}
.impress-reviews__person-text{display:flex;flex-direction:column;gap:3px;min-width:0;font-size:12px;color:#888888}
.impress-reviews__person-text strong{font-size:14px;color:#111111;overflow-wrap:anywhere}
.impress-reviews__original{display:inline-flex;align-items:center;gap:5px;align-self:flex-start;color:#444b53;text-decoration:none;font-size:12px;font-weight:800}
.impress-reviews__original:hover{text-decoration:underline;color:#111111}
.impress-reviews__original:focus-visible{outline:2px solid var(--ir-accent,#fbbf00);outline-offset:3px}
.impress-reviews__app-widgets{margin-top:26px;min-width:0}
.impress-reviews__editor-empty{padding:24px;margin:0 auto;max-width:1240px;border:1px dashed #b9bfc8;border-radius:14px;background:#f7f8f9;color:#505660;font-size:13px;line-height:1.6}
.impress-reviews__editor-empty strong{display:block;color:#111111;font-size:16px;margin-bottom:5px}
@media(max-width:1000px){.impress-reviews__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:650px){.impress-reviews{padding:52px 16px}.impress-reviews__grid{grid-template-columns:minmax(0,1fr);gap:14px}.impress-reviews__card{padding:20px}.impress-reviews__card-top{margin-bottom:16px}}
@media(prefers-reduced-motion:reduce){.impress-reviews__card{scroll-behavior:auto}}
{% endstylesheet %}

{% schema %}
{
  "name": "Reseñas Google/Facebook",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Etiqueta","default":"OPINIONES DE CLIENTES"},
    {"type":"text","id":"heading","label":"Título","default":"Lo que dicen nuestros clientes"},
    {"type":"textarea","id":"description","label":"Descripción","default":"Opiniones reales compartidas por nuestros clientes."},
    {"type":"checkbox","id":"only_five_stars","label":"Ocultar valoraciones de menos de 5 estrellas","default":true,"info":"Se aplica a las reseñas añadidas manualmente; las recomendaciones de Facebook se identifican por separado. Los widgets de aplicaciones usan sus propios filtros."},
    {"type":"range","id":"max_width","label":"Ancho","min":900,"max":1440,"step":20,"default":1240},
    {"type":"color","id":"bg_color","label":"Fondo","default":"#f7f8f9"},
    {"type":"color","id":"accent_color","label":"Acento de estrellas","default":"#fbbf00"}
  ],
  "blocks": [
    {
      "type":"review",
      "name":"Reseña de cliente",
      "settings":[
        {"type":"paragraph","content":"Utiliza solo reseñas auténticas que tengas autorización para mostrar. Para Google, incluye el enlace directo a la reseña original cuando lo tengas."},
        {"type":"text","id":"author","label":"Nombre del cliente"},
        {"type":"textarea","id":"quote","label":"Comentario original"},
        {"type":"select","id":"source","label":"Plataforma de origen","options":[{"value":"google","label":"Google"},{"value":"facebook","label":"Facebook"},{"value":"other","label":"Otra fuente"}],"default":"other"},
        {"type":"select","id":"rating_type","label":"Tipo de reseña","options":[{"value":"stars","label":"Estrellas"},{"value":"recommended","label":"Recomendación (Facebook)"}],"default":"stars"},
        {"type":"range","id":"stars","label":"Estrellas reales","min":0,"max":5,"step":1,"default":0,"info":"Selecciona la valoración auténtica. Para recomendaciones sin estrellas, usa el tipo Recomendación."},
        {"type":"url","id":"review_url","label":"Enlace a la reseña original"},
        {"type":"text","id":"context","label":"Empresa o detalle (opcional)"},
        {"type":"image_picker","id":"avatar","label":"Foto de perfil autorizada (opcional)"}
      ]
    },
    {"type":"@app"}
  ],
  "presets": [{"name":"Reseñas Google/Facebook"}]
}
{% endschema %}
