{% liquid
  assign catalog_collection = collection
  if catalog_collection == blank
    assign catalog_collection = collections['all']
  endif
%}
<section class="impress-all-products">
  <div class="impress-all-products__inner">
    <div class="impress-all-products__intro">
      <div><p class="impress-all-products__eyebrow">CATÁLOGO IMPRESS</p><h1>{{ section.settings.heading | default: catalog_collection.title | escape }}</h1><p>{{ section.settings.description | escape }}</p></div>
      {% if catalog_collection.sort_options.size > 0 %}
        <form class="impress-all-products__sort" method="get">
          <label for="CatalogSort-{{ section.id }}">Ordenar por</label>
          <select id="CatalogSort-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
            {% assign selected_sort = catalog_collection.sort_by | default: catalog_collection.default_sort_by %}
            {% for sort_option in catalog_collection.sort_options %}
              <option value="{{ sort_option.value | escape }}" {% if selected_sort == sort_option.value %}selected{% endif %}>{{ sort_option.name | escape }}</option>
            {% endfor %}
          </select>
        </form>
      {% endif %}
    </div>
    {% paginate catalog_collection.products by 24 %}
      <div class="impress-all-products__grid">
        {% for item in catalog_collection.products %}
          {% assign is_service = false %}
          {% if item.tags contains 'impress-addon' or item.type == 'Service' or item.type == 'Servicio' or item.variants.first.metafields.custom.impress_addon_role.value != blank or item.variants.first.metafields.custom.impress_addon_group.value != blank %}{% assign is_service = true %}{% endif %}
          {% unless is_service %}
            <a href="{{ item.url }}" class="impress-all-products__card">
              <div class="impress-all-products__media">
                {% if item.featured_image != blank %}
                  {{ item.featured_image | image_url: width: 740 | image_tag: loading: 'lazy', widths: '300, 500, 740', sizes: '(max-width: 650px) 90vw, (max-width: 990px) 45vw, 25vw', alt: item.title }}
                {% else %}<span aria-hidden="true">IMPRESS ✦</span>{% endif %}
              </div>
              <div class="impress-all-products__content">
                <h2>{{ item.title | escape }}</h2>
                <p>{{ item.description | strip_html | truncate: 100 }}</p>
                <div class="impress-all-products__meta"><span>{% if item.price_varies %}Desde {% endif %}{{ item.price_min | money }}</span><b>Ver producto →</b></div>
              </div>
            </a>
          {% endunless %}
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}
        <nav class="impress-all-products__pagination" aria-label="Páginas del catálogo">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Anterior</a>{% endif %}
          <span>Página {{ paginate.current_page }} de {{ paginate.pages }}</span>
          {% if paginate.next %}<a href="{{ paginate.next.url }}">Siguiente →</a>{% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>
{% stylesheet %}
.impress-all-products{background:#f9fafb;padding:60px 20px 80px;font-family:system-ui,sans-serif}
.impress-all-products__inner{max-width:1240px;margin:auto}
.impress-all-products__intro{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:36px}
.impress-all-products__eyebrow{font-size:12px;color:#9b7500;letter-spacing:1.5px;font-weight:850;margin:0 0 12px}
.impress-all-products__intro h1{font-size:clamp(38px,4.5vw,64px);font-weight:900;line-height:1.05;letter-spacing:-.045em;color:#15171b;margin:0 0 14px}
.impress-all-products__intro p:not(.impress-all-products__eyebrow){font-size:16px;color:#656a73;max-width:60ch;line-height:1.6;margin:0}
.impress-all-products__sort{display:flex;flex-direction:column;gap:6px;min-width:190px;font-size:12px;font-weight:750;color:#45494f}
.impress-all-products__sort select{background:white;border:1px solid #d4d6d9;border-radius:10px;padding:12px;font:inherit;color:#222}
.impress-all-products__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.impress-all-products__card{border-radius:22px;overflow:hidden;display:block;background:#fff;color:#181a20;border:1px solid #e8eaed;text-decoration:none;transition:box-shadow .2s,transform .2s}
.impress-all-products__card:hover{transform:translateY(-4px);box-shadow:0 14px 32px #00000017}
.impress-all-products__media{height:250px;background:#edf0f2;display:flex;justify-content:center;align-items:center;color:#5e6268;font-weight:900}
.impress-all-products__media img{width:100%;height:100%;object-fit:contain;padding:14px}
.impress-all-products__content{padding:23px}.impress-all-products__content h2{font-size:23px;line-height:1.18;font-weight:850;margin:0 0 9px;color:#171a1e}.impress-all-products__content p{color:#6b6f77;font-size:14px;line-height:1.6;margin:0 0 22px;min-height:40px}
.impress-all-products__meta{display:flex;justify-content:space-between;gap:10px;align-items:center}.impress-all-products__meta span{font-size:17px;font-weight:850}.impress-all-products__meta b{font-size:12px;background:#fbbf00;padding:9px 12px;border-radius:999px;white-space:nowrap}
.impress-all-products__pagination{margin-top:40px;display:flex;justify-content:center;gap:25px;align-items:center;font-size:14px}.impress-all-products__pagination a{color:#15181e;font-weight:750;text-decoration:none}
@media(max-width:900px){.impress-all-products__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.impress-all-products{padding:50px 16px}.impress-all-products__intro{flex-direction:column;align-items:start}.impress-all-products__grid{grid-template-columns:1fr}.impress-all-products__media{height:220px}}
{% endstylesheet %}
{% schema %}
{"name":"Impress All Products","settings":[
{"type":"text","id":"heading","label":"Título","default":"Todo lo que puedes imprimir"},
{"type":"textarea","id":"description","label":"Introducción","default":"Explora nuestros productos y configura tus opciones de impresión directamente en línea."}
],"presets":[{"name":"Impress All Products"}]}
{% endschema %}
