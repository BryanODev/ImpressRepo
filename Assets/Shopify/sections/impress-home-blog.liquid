{% comment %}
  IMPRESS | Blog Showcase
  Article cards use real published Shopify blog posts. The layout follows
  Impress Product Showcase styling while keeping all articles in one row.
{% endcomment %}
{% liquid
  assign impress_blog = section.settings.blog
  if impress_blog == blank
    assign impress_blog = blogs['news']
  endif
  assign visible_gap_sum = section.settings.desktop_visible | minus: 1 | times: section.settings.card_gap
  assign blog_ready = false
  if impress_blog != blank and impress_blog.articles_count > 0
    assign blog_ready = true
  endif
%}

{% if blog_ready %}
<section
  id="impress-blog-{{ section.id }}"
  class="impress-blog-showcase"
  style="
    --ib-max: {{ section.settings.max_width }}px;
    --ib-pad-top: {{ section.settings.padding_top }}px;
    --ib-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ib-accent: {{ section.settings.accent_color }};
    --ib-bg: {{ section.settings.bg_color }};
    --ib-desktop-visible: {{ section.settings.desktop_visible }};
    --ib-gap: {{ section.settings.card_gap }}px;
    --ib-gap-sum: {{ visible_gap_sum }}px;
    --ib-ratio: {{ section.settings.image_ratio }};
  "
  aria-labelledby="impress-blog-heading-{{ section.id }}"
>
  <div class="impress-blog-showcase__wrap">
    <div class="impress-blog-showcase__heading-row">
      <div class="impress-blog-showcase__heading-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="impress-blog-showcase__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 id="impress-blog-heading-{{ section.id }}" class="impress-blog-showcase__title">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>
      {% if section.settings.description != blank %}
        <p class="impress-blog-showcase__intro">{{ section.settings.description | escape }}</p>
      {% endif %}
    </div>

    {% assign visible_post_count = impress_blog.articles_count | at_most: section.settings.limit %}
    <div class="impress-blog-showcase__rail" data-impress-blog-rail tabindex="0" aria-label="Artículos del blog {{ impress_blog.title | escape }}">
      {% for article in impress_blog.articles limit: section.settings.limit %}
        <article class="impress-blog-showcase__item">
          <div class="impress-blog-showcase__media">
            <a href="{{ article.url }}" class="impress-blog-showcase__image-link" aria-label="Leer: {{ article.title | escape }}">
              {% if article.image != blank %}
                {{ article.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000, 1400', sizes: '(min-width: 1200px) 410px, (min-width: 700px) 46vw, 88vw', alt: article.title }}
              {% else %}
                <span class="impress-blog-showcase__image-placeholder" aria-hidden="true">im<span>press</span><b>✦</b></span>
              {% endif %}
            </a>
            {% if section.settings.show_tag %}
              {% assign article_card_tag = section.settings.fallback_tag %}
              {% if section.settings.use_article_tags and article.tags.size > 0 %}
                {% assign article_card_tag = article.tags.first %}
              {% endif %}
              {% if article_card_tag != blank %}
                <span class="impress-blog-showcase__tag">{{ article_card_tag | escape }}</span>
              {% endif %}
            {% endif %}
          </div>
          <div class="impress-blog-showcase__detail">
            <div class="impress-blog-showcase__copy">
              {% if section.settings.show_date %}
                <p class="impress-blog-showcase__date">{{ article.published_at | date: '%d %b %Y' }}</p>
              {% endif %}
              <h3 class="impress-blog-showcase__item-title">{{ article.title | escape }}</h3>
              <p class="impress-blog-showcase__item-text">{{ article.excerpt_or_content | strip_html | truncate: 135 | escape }}</p>
            </div>
            <a href="{{ article.url }}" class="impress-blog-showcase__link">
              {{ section.settings.cta_label | escape }} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      {% endfor %}
    </div>

    {% if visible_post_count > 1 %}
      <div class="impress-blog-showcase__navigation{% if visible_post_count <= section.settings.desktop_visible %} impress-blog-showcase__navigation--mobile-only{% endif %}" aria-label="Navegación de artículos">
        <span class="impress-blog-showcase__hint">Desliza para explorar más artículos</span>
        <div class="impress-blog-showcase__arrows">
          <button type="button" class="impress-blog-showcase__arrow" data-impress-blog-scroll="prev" aria-label="Artículos anteriores">←</button>
          <button type="button" class="impress-blog-showcase__arrow" data-impress-blog-scroll="next" aria-label="Artículos siguientes">→</button>
        </div>
      </div>
    {% endif %}

    {% if section.settings.show_view_all %}
      <a class="impress-blog-showcase__view-all" href="{{ impress_blog.url }}">
        <span>{{ section.settings.button_label | escape }}</span>
        <span aria-hidden="true">↗</span>
      </a>
    {% endif %}
  </div>
  <script>
    (() => {
      const root = document.getElementById('impress-blog-{{ section.id }}');
      if (!root || root.dataset.impressBlogReady === 'true') return;
      root.dataset.impressBlogReady = 'true';
      const rail = root.querySelector('[data-impress-blog-rail]');
      if (!rail) return;
      root.querySelectorAll('[data-impress-blog-scroll]').forEach(button => {
        button.addEventListener('click', () => {
          const firstCard = rail.querySelector('.impress-blog-showcase__item');
          const gap = parseFloat(window.getComputedStyle(rail).columnGap) || 20;
          const distance = (firstCard ? firstCard.getBoundingClientRect().width : rail.clientWidth) + gap;
          const direction = button.getAttribute('data-impress-blog-scroll') === 'next' ? 1 : -1;
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          rail.scrollBy({ left: distance * direction, behavior: reduceMotion ? 'instant' : 'smooth' });
        });
      });
    })();
  </script>
</section>
{% elsif request.design_mode %}
  <div class="impress-blog-showcase__empty" style="padding:24px; margin:20px auto; max-width:800px; text-align:center; background:#f4f4f4; color:#333; border-radius:12px;">
    <strong>Impress Blog:</strong> selecciona un blog con artículos publicados en los ajustes de esta sección. Los artículos se cargarán automáticamente.
  </div>
{% endif %}

{% stylesheet %}
.impress-blog-showcase { background:var(--ib-bg,#f7f8f9); padding:var(--ib-pad-top,50px) 20px var(--ib-pad-bottom,55px); font-family:system-ui,-apple-system,sans-serif; }
.impress-blog-showcase * { box-sizing:border-box; }
.impress-blog-showcase__wrap { max-width:var(--ib-max,1240px); margin-inline:auto; }
.impress-blog-showcase__heading-row { display:flex; align-items:end; justify-content:space-between; gap:28px; margin-bottom:28px; }
.impress-blog-showcase__heading-copy { max-width:700px; }
.impress-blog-showcase__eyebrow { margin:0 0 10px; color:#987200; font-size:12px; letter-spacing:1.5px; font-weight:850; text-transform:uppercase; }
.impress-blog-showcase__title { margin:0; color:#121316; font-size:clamp(30px,3.8vw,46px); font-weight:900; line-height:1.08; letter-spacing:-.035em; }
.impress-blog-showcase__intro { margin:0; width:100%; max-width:410px; color:#666b74; font-size:15px; line-height:1.65; }
.impress-blog-showcase__rail { display:grid; grid-auto-flow:column; grid-auto-columns:calc((100% - var(--ib-gap-sum,40px)) / var(--ib-desktop-visible,3)); gap:var(--ib-gap,20px); overflow-x:auto; overflow-y:hidden; scroll-snap-type:x mandatory; scroll-padding-inline:2px; scrollbar-width:thin; scrollbar-color:#c4c7cc transparent; padding:4px 2px 10px; overscroll-behavior-x:contain; }
.impress-blog-showcase__rail:focus-visible { outline:2px solid var(--ib-accent,#fbbf00); outline-offset:2px; }
.impress-blog-showcase__item { border-radius:24px; overflow:hidden; background:#fff; border:1px solid #e8e9ec; box-shadow:0 12px 32px rgba(14,17,26,.07); min-width:0; scroll-snap-align:start; display:flex; flex-direction:column; }
.impress-blog-showcase__media { aspect-ratio:var(--ib-ratio,1.53); background:#e9ecef; position:relative; overflow:hidden; flex:none; }
.impress-blog-showcase__image-link { display:block; width:100%; height:100%; color:inherit; text-decoration:none; }
.impress-blog-showcase__media img { display:block; width:100%; height:100%; object-fit:cover; transition:transform .6s cubic-bezier(.2,.65,.2,1); }
.impress-blog-showcase__item:hover .impress-blog-showcase__media img { transform:scale(1.045); }
.impress-blog-showcase__image-placeholder { display:flex; width:100%; height:100%; align-items:center; justify-content:center; background:#21252b; color:#fff; font-size:30px; letter-spacing:-1px; font-weight:500; }
.impress-blog-showcase__image-placeholder span { color:var(--ib-accent,#fbbf00); font-weight:900; }
.impress-blog-showcase__image-placeholder b { color:var(--ib-accent,#fbbf00); font-size:19px; margin-left:10px; }
.impress-blog-showcase__tag { position:absolute; left:20px; top:20px; border-radius:999px; background:var(--ib-accent,#fbbf00); color:#161616; font-size:11px; font-weight:850; padding:9px 12px; line-height:1; letter-spacing:.45px; text-transform:uppercase; box-shadow:0 4px 12px rgba(0,0,0,.11); max-width:calc(100% - 40px); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; pointer-events:none; }
.impress-blog-showcase__detail { padding:23px 24px 24px; display:flex; flex:1; flex-direction:column; align-items:stretch; justify-content:space-between; gap:18px; }
.impress-blog-showcase__date { margin:0 0 9px; color:#8b9099; font-size:11px; font-weight:800; letter-spacing:.7px; text-transform:uppercase; }
.impress-blog-showcase__item-title { margin:0 0 7px; font-size:23px; font-weight:880; line-height:1.15; color:#121316; letter-spacing:-.025em; overflow-wrap:anywhere; }
.impress-blog-showcase__item-text { margin:0; color:#60646b; line-height:1.5; font-size:14px; overflow-wrap:anywhere; }
.impress-blog-showcase__link { align-self:flex-start; display:inline-flex; align-items:center; gap:9px; text-decoration:none; border-radius:100px; padding:12px 16px; color:#131313; background:var(--ib-accent,#fbbf00); font-size:13px; font-weight:850; transition:transform .2s ease,background-color .2s ease; }
.impress-blog-showcase__link:hover { transform:translateY(-2px); background:#ffd84f; }
.impress-blog-showcase__link:focus-visible,.impress-blog-showcase__view-all:focus-visible { outline:3px solid #111; outline-offset:3px; }
.impress-blog-showcase__link span { font-size:17px; }
.impress-blog-showcase__navigation { display:flex; align-items:center; justify-content:space-between; gap:18px; margin-top:12px; }
.impress-blog-showcase__hint { color:#838891; font-size:12px; }
.impress-blog-showcase__arrows { display:flex; gap:8px; }
.impress-blog-showcase__arrow { cursor:pointer; display:grid; place-items:center; border:1px solid #d6d9dd; color:#17191d; background:#fff; width:38px; height:38px; border-radius:100%; font-size:18px; line-height:1; transition:background .2s ease,border-color .2s ease; }
.impress-blog-showcase__arrow:hover { border-color:#17191d; background:#f1f2f3; }
.impress-blog-showcase__arrow:focus-visible { outline:2px solid #17191d; outline-offset:2px; }
.impress-blog-showcase__view-all { margin-top:22px; display:flex; align-items:center; justify-content:space-between; gap:20px; width:100%; padding:18px 24px; border-radius:15px; color:#151515; background:var(--ib-accent,#fbbf00); font-size:15px; font-weight:850; text-decoration:none; transition:transform .2s ease,filter .2s ease; }
.impress-blog-showcase__view-all:hover { transform:translateY(-2px); filter:brightness(1.04); }
.impress-blog-showcase__view-all span:last-child { font-size:23px; line-height:1; }
@media(min-width:901px) { .impress-blog-showcase__navigation--mobile-only { display:none; } }
@media(max-width:900px) { .impress-blog-showcase__heading-row { align-items:start; flex-direction:column; gap:12px; } .impress-blog-showcase__rail { grid-auto-columns:calc((100% - var(--ib-gap,20px)) / 2); } }
@media(max-width:700px) { .impress-blog-showcase { padding-left:16px; padding-right:16px; } .impress-blog-showcase__rail { grid-auto-columns:min(86%,380px); gap:16px; } .impress-blog-showcase__media { aspect-ratio:1.5; } .impress-blog-showcase__detail { padding:20px; gap:15px; } .impress-blog-showcase__tag { top:14px; left:14px; } .impress-blog-showcase__view-all { padding:16px 19px; } }
@media(prefers-reduced-motion:reduce) { .impress-blog-showcase__media img,.impress-blog-showcase__link,.impress-blog-showcase__view-all { transition:none; } .impress-blog-showcase__rail { scroll-behavior:auto; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Impress Blog Posts",
  "settings": [
    {"type":"blog","id":"blog","label":"Blog de Shopify"},
    {"type":"text","id":"eyebrow","label":"Etiqueta superior","default":"BLOG IMPRESS"},
    {"type":"text","id":"heading","label":"Título","default":"Consejos e inspiración"},
    {"type":"textarea","id":"description","label":"Descripción","default":"Ideas para preparar tu arte, elegir materiales y sacar más provecho de tus impresos."},
    {"type":"header","content":"Tarjetas"},
    {"type":"range","id":"limit","label":"Número de artículos","min":1,"max":9,"step":1,"default":3},
    {"type":"range","id":"desktop_visible","label":"Tarjetas visibles en computadora","min":1,"max":4,"step":1,"default":3},
    {"type":"range","id":"card_gap","label":"Separación entre tarjetas","min":12,"max":32,"step":2,"default":20,"unit":"px"},
    {"type":"select","id":"image_ratio","label":"Proporción de imagen","options":[{"value":"1.53","label":"Horizontal (como Showcase)"},{"value":"1.33","label":"Horizontal alta"},{"value":"1","label":"Cuadrada"}],"default":"1.53"},
    {"type":"checkbox","id":"show_date","label":"Mostrar fecha","default":true},
    {"type":"checkbox","id":"show_tag","label":"Mostrar etiqueta sobre imagen","default":true},
    {"type":"checkbox","id":"use_article_tags","label":"Usar primera etiqueta del artículo","default":false},
    {"type":"text","id":"fallback_tag","label":"Etiqueta por defecto","default":"ARTÍCULO"},
    {"type":"text","id":"cta_label","label":"Texto botón de tarjeta","default":"Leer artículo"},
    {"type":"header","content":"Ver todos los artículos"},
    {"type":"checkbox","id":"show_view_all","label":"Mostrar botón Ver todos","default":true},
    {"type":"text","id":"button_label","label":"Texto de Ver todos","default":"Ver todos los artículos"},
    {"type":"header","content":"Diseño"},
    {"type":"range","id":"max_width","label":"Ancho máximo","min":900,"max":1400,"step":20,"default":1240,"unit":"px"},
    {"type":"range","id":"padding_top","label":"Espacio superior","min":0,"max":120,"step":5,"default":50,"unit":"px"},
    {"type":"range","id":"padding_bottom","label":"Espacio inferior","min":0,"max":120,"step":5,"default":55,"unit":"px"},
    {"type":"color","id":"bg_color","label":"Color de fondo","default":"#f7f8f9"},
    {"type":"color","id":"accent_color","label":"Color de botones","default":"#fbbf00"}
  ],
  "presets":[{"name":"Impress Blog Posts"}]
}
{% endschema %}
