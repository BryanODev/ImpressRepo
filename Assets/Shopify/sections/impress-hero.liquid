{{ 'impress-hero-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'impress-hero-slider.js' | asset_url }}" defer></script>
{% comment %} IMPRESS HOMEPAGE HERO. Slides are editable Shopify blocks; product rules stay outside this section. {% endcomment %}
<section id="ImpressHero-{{ section.id }}" class="impress-slidehero{% if section.settings.full_bleed %} impress-slidehero--full{% endif %}"
  data-impress-slidehero
  data-auto-play="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_seconds | times: 1000 }}"
  style="--ish-radius: {{ section.settings.card_radius }}px; --ish-accent: {{ section.settings.subheading_color }}; --ish-height: {{ section.settings.card_min_height }}px; --ish-screen-height: {{ section.settings.viewport_height }}svh; --ish-max: {{ section.settings.max_width }}px; --ish-top: {{ section.settings.padding_top }}px; --ish-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="impress-slidehero__shell">
    <div class="impress-slidehero__viewport" data-ish-viewport aria-roledescription="carrusel" aria-label="Promociones y productos Impress">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign visual = block.settings.fallback_visual -%}
          {%- assign visual_asset = 'impress-hero-sticker-collage.png' -%}
          {%- if visual == 'banners' -%}{%- assign visual_asset = 'impress-showcase-banners.svg' -%}{%- endif -%}
          {%- if visual == 'business' -%}{%- assign visual_asset = 'impress-hero-business-cards.svg' -%}{%- endif -%}
          {%- if visual == 'flyers' -%}{%- assign visual_asset = 'impress-hero-flyers.svg' -%}{%- endif -%}
          <article class="impress-slidehero__slide{% if forloop.first %} is-active{% endif %}" data-ish-slide
            data-block-id="{{ block.id }}" data-index="{{ forloop.index0 }}"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            {% unless forloop.first %}inert{% endunless %}
            style="--ish-surface: {{ block.settings.surface_color }}; --ish-text: {{ block.settings.text_color }};" {{ block.shopify_attributes }}>
            <div class="impress-slidehero__copy">
              {% if block.settings.eyebrow != blank %}<p class="impress-slidehero__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
              {% if block.settings.heading != blank %}<h2 class="impress-slidehero__title">{{ block.settings.heading | escape }}</h2>{% endif %}
              {% if block.settings.description != blank %}<p class="impress-slidehero__description">{{ block.settings.description | escape }}</p>{% endif %}
              <div class="impress-slidehero__actions">
                {% if block.settings.primary_text != blank and block.settings.primary_url != blank %}
                  <a class="impress-slidehero__btn impress-slidehero__btn--primary" href="{{ block.settings.primary_url }}">{{ block.settings.primary_text | escape }} <span aria-hidden="true">→</span></a>
                {% endif %}
                {% if block.settings.secondary_text != blank and block.settings.secondary_url != blank %}
                  <a class="impress-slidehero__btn impress-slidehero__btn--secondary" href="{{ block.settings.secondary_url }}">{{ block.settings.secondary_text | escape }}</a>
                {% endif %}
              </div>
            </div>
            <div class="impress-slidehero__media" aria-hidden="true">
              <div class="impress-slidehero__image-wrap">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', class: 'impress-slidehero__image' }}
                {%- else -%}
                  <img class="impress-slidehero__image" src="{{ visual_asset | asset_url }}" width="1200" height="900" alt="" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        <article class="impress-slidehero__slide is-active impress-slidehero__slide--empty" data-ish-slide data-index="0" aria-hidden="false">
          <div class="impress-slidehero__copy"><p class="impress-slidehero__eyebrow">IMPRESS</p><h2 class="impress-slidehero__title">Impresión personalizada para tu negocio.</h2><p class="impress-slidehero__description">Añade diapositivas en el editor de temas.</p></div>
          <div class="impress-slidehero__media"><img class="impress-slidehero__image" src="{{ 'impress-hero-sticker-collage.png' | asset_url }}" width="1200" height="900" alt=""></div>
        </article>
      {%- endif -%}
      {% if section.blocks.size > 1 %}
        <div class="impress-slidehero__navigation" aria-label="Controles del carrusel">
          <button type="button" class="impress-slidehero__arrow" data-ish-prev aria-label="Diapositiva anterior">‹</button>
          <div class="impress-slidehero__dots" role="group" aria-label="Elegir diapositiva">
            {% for block in section.blocks %}<button type="button" data-ish-dot="{{ forloop.index0 }}" aria-label="Ir a diapositiva {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" class="{% if forloop.first %}is-active{% endif %}"></button>{% endfor %}
          </div>
          <button type="button" class="impress-slidehero__arrow" data-ish-next aria-label="Siguiente diapositiva">›</button>
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Impress Hero",
  "settings": [
    {"type":"header","content":"Carrusel"},
    {"type":"checkbox","id":"autoplay","label":"Cambiar diapositivas automáticamente","default":true},
    {"type":"range","id":"autoplay_seconds","label":"Segundos por diapositiva","min":3,"max":12,"step":1,"default":6,"unit":"s"},
    {"type":"header","content":"Diseño"},
    {"type":"checkbox","id":"full_bleed","label":"Hero ancho completo, sin bordes de tarjeta","default":true},
    {"type":"range","id":"viewport_height","label":"Altura de pantalla (desktop)","min":60,"max":100,"step":5,"unit":"%","default":90},
    {"type":"range","id":"max_width","label":"Maximum Width","min":800,"max":1400,"step":20,"default":1320,"unit":"px"},
    {"type":"range","id":"card_min_height","label":"Minimum Height","min":300,"max":900,"step":20,"default":560,"unit":"px"},
    {"type":"range","id":"card_radius","label":"Card Corner Radius","min":0,"max":60,"step":2,"default":24,"unit":"px"},
    {"type":"color","id":"card_bg","label":"Legacy background (not used by slides)","default":"#121212"},
    {"type":"image_picker","id":"bg_image","label":"Legacy image (set per slide instead)"},
    {"type":"range","id":"overlay_opacity","label":"Legacy overlay (not used)","min":0,"max":100,"step":5,"default":40,"unit":"%"},
    {"type":"text","id":"subheading","label":"Legacy subtitle (set per slide)","default":"STICKERS Y BANNERS PERSONALIZADOS"},
    {"type":"color","id":"subheading_color","label":"Accent color","default":"#fbbf00"},
    {"type":"text","id":"heading","label":"Legacy title (set per slide)","default":"Impresión personalizada"},
    {"type":"color","id":"heading_color","label":"Legacy heading color","default":"#ffffff"},
    {"type":"textarea","id":"description","label":"Legacy description","default":"Productos impresos para tu negocio."},
    {"type":"color","id":"desc_color","label":"Legacy description color","default":"#a1a1aa"},
    {"type":"text","id":"primary_btn_text","label":"Legacy primary button","default":"Ordenar Stickers"},
    {"type":"url","id":"primary_btn_link","label":"Legacy primary link"},
    {"type":"text","id":"secondary_btn_text","label":"Legacy secondary button","default":"Ordenar Banners"},
    {"type":"url","id":"secondary_btn_link","label":"Legacy secondary link"},
    {"type":"text","id":"caption_text","label":"Legacy caption","default":"Explorar productos"},
    {"type":"url","id":"caption_link","label":"Legacy caption link"},
    {"type":"number","id":"padding_top","label":"Top padding (px)","default":25},
    {"type":"number","id":"padding_bottom","label":"Bottom padding (px)","default":25}
  ],
  "blocks": [{"type":"slide","name":"Diapositiva","settings":[
    {"type":"text","id":"eyebrow","label":"Etiqueta","default":"IMPRESS PRINTING"},
    {"type":"text","id":"heading","label":"Título","default":"Impresión para tu próximo proyecto."},
    {"type":"textarea","id":"description","label":"Descripción","default":"Personaliza y ordena con confianza."},
    {"type":"text","id":"primary_text","label":"Botón principal","default":"Explorar productos"},
    {"type":"url","id":"primary_url","label":"Destino principal"},
    {"type":"text","id":"secondary_text","label":"Botón secundario","default":"Conoce más"},
    {"type":"url","id":"secondary_url","label":"Destino secundario"},
    {"type":"image_picker","id":"image","label":"Imagen del producto"},
    {"type":"select","id":"fallback_visual","label":"Imagen provisional","options":[
      {"value":"stickers","label":"Stickers"},{"value":"banners","label":"Banners"},{"value":"business","label":"Business Cards"},{"value":"flyers","label":"Flyers"}
    ],"default":"stickers"},
    {"type":"color","id":"surface_color","label":"Fondo","default":"#f6f6f3"},
    {"type":"color","id":"text_color","label":"Texto","default":"#111318"}
  ]}],
  "max_blocks":8,
  "presets":[{"name":"Impress Hero","blocks":[
    {"type":"slide","settings":{"fallback_visual":"stickers","heading":"Stickers personalizados","eyebrow":"VINYL STICKERS"}},
    {"type":"slide","settings":{"fallback_visual":"banners","heading":"Banners para tu negocio","eyebrow":"GRAN FORMATO"}}
  ]}]
}
{% endschema %}
