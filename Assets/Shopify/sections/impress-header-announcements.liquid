{% style %}
  #shopify-section-{{ section.id }} .marquee-announcement-bar {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .marquee-announcement__link {
    color: {{ section.settings.text_color }};
  }

  {% if section.settings.pause_on_hover %}
    #shopify-section-{{ section.id }} .marquee-announcement-bar:hover .marquee-announcement__track {
      animation-play-state: paused;
    }
  {% endif %}
{% endstyle %}

<aside
  class="announcement-bar marquee-announcement-bar section--{{ section.settings.section_width }}"
  style="
    --marquee-speed: {{ section.settings.speed }}s;
    --marquee-gap: {{ section.settings.item_gap }}px;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --border-bottom-width: {{ section.settings.divider_width }}px;
    {% if section.settings.divider_color != blank %}--color-border: {{ section.settings.divider_color }};{% endif %}
  "
>
  <div class="marquee-announcement__track-wrapper">
    <div class="marquee-announcement__track" id="MarqueeTrack-{{ section.id }}">
      
      {% capture marquee_content %}
        {% for block in section.blocks %}
          <div class="marquee-announcement__item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="marquee-announcement__link">
            {% endif %}

            <span class="marquee-announcement__text">{{ block.settings.text }}</span>

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      {% endcapture %}

      <div class="marquee-announcement__content">
        {{ marquee_content }}
        {{ marquee_content }}
        {{ marquee_content }}
        {{ marquee_content }}
      </div>

      <div class="marquee-announcement__content" aria-hidden="true">
        {{ marquee_content }}
        {{ marquee_content }}
        {{ marquee_content }}
        {{ marquee_content }}
      </div>

    </div>
  </div>
</aside>

{% stylesheet %}
  .marquee-announcement-bar {
    overflow: hidden;
    width: 100%;
    position: relative;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    border-block-end: var(--border-bottom-width) solid var(--color-border, transparent);
  }

  .marquee-announcement__track-wrapper {
    display: flex;
    overflow: hidden;
    width: 100%;
    user-select: none;
    mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
  }

  .marquee-announcement__track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    animation: announcement-marquee var(--marquee-speed) linear infinite;
  }

  .marquee-announcement__content {
    display: flex;
    align-items: center;
  }

  .marquee-announcement__item {
    display: inline-flex;
    align-items: center;
    padding-right: var(--marquee-gap);
    flex-shrink: 0;
  }

  .marquee-announcement__text {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    line-height: 1;
  }

  .marquee-announcement__link {
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .marquee-announcement__link:hover {
    opacity: 0.75;
  }

  @keyframes announcement-marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Marquee Announcement Bar",
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Special Offer: Free Shipping on Orders Over $50"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Marquee Settings"
    },
    {
      "type": "number",
      "id": "speed",
      "label": "Scroll Duration / Speed (seconds)",
      "info": "Lower number = Faster speed",
      "default": 15
    },
    {
      "type": "number",
      "id": "item_gap",
      "label": "Space Between Announcements (px)",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause marquee on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Appearance & Padding"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top Padding (px)",
      "default": 12
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom Padding (px)",
      "default": 12
    },
    {
      "type": "number",
      "id": "divider_width",
      "label": "Bottom Border Thickness (px)",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Bottom Border Color"
    }
  ],
  "presets": [
    {
      "name": "Marquee Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "FREE SHIPPING ON ORDERS OVER $50"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "NEW ARRIVALS JUST DROPPED • SHOP NOW"
          }
        }
      ]
    }
  ]
}
{% endschema %}