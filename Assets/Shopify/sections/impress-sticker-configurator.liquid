<div 
  class="sticker-config-wrapper" 
  style="
    --padding-v: {{ section.settings.vertical_padding }}px;
    --max-width: {{ section.settings.max_width }}px;
    --bg-color: {{ section.settings.bg_color }};
    --card-bg: {{ section.settings.card_bg_color }};
    --accent-yellow: {{ section.settings.accent_yellow }};
    --text-color: {{ section.settings.text_color }};
    --text-sub: {{ section.settings.text_sub_color }};
  "
>
  <div class="sticker-config-container">
    
    <!-- Header -->
    <div class="config-header">
      {% if section.settings.subheading != blank %}
        <span class="config-subheading">{{ section.settings.subheading }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="config-heading">{{ section.settings.heading }}</h1>
      {% endif %}
    </div>

    <!-- Main Configurator Layout -->
    <div class="config-grid">
      
      <!-- Left Column: Step-by-Step Options -->
      <div class="config-steps-col">
        
        <!-- Step 1: Shape & Cut -->
        <div class="config-step-card">
          <div class="step-title-row">
            <span class="step-badge">1</span>
            <h3 class="step-heading">Elige la Forma / Corte</h3>
          </div>
          <div class="options-grid grid-3">
            <label class="option-card shape-option active">
              <input type="radio" name="sticker_shape" value="Die Cut" checked>
              <div class="option-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
              </div>
              <span class="option-label">Die Cut</span>
              <span class="option-desc">Corte individual</span>
            </label>

            <label class="option-card shape-option">
              <input type="radio" name="sticker_shape" value="Kiss Cut">
              <div class="option-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="4"/><rect x="7" y="7" width="10" height="10" rx="2" stroke-dasharray="2 2"/></svg>
              </div>
              <span class="option-label">Kiss Cut</span>
              <span class="option-desc">Con borde extra</span>
            </label>

            <label class="option-card shape-option">
              <input type="radio" name="sticker_shape" value="Circle / Square">
              <div class="option-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/></svg>
              </div>
              <span class="option-label">Círculo / Cuadrado</span>
              <span class="option-desc">Forma estándar</span>
            </label>
          </div>
        </div>

        <!-- Step 2: Material & Finish -->
        <div class="config-step-card">
          <div class="step-title-row">
            <span class="step-badge">2</span>
            <h3 class="step-heading">Elige el Acabado</h3>
          </div>
          <div class="options-grid grid-2">
            <label class="option-card material-option active">
              <input type="radio" name="sticker_finish" value="Glossy" checked>
              <div class="option-info">
                <span class="option-label">Vinilo Brillante (Gloss)</span>
                <span class="option-desc">Colores vivos, reflejo brillante e impermeable</span>
              </div>
            </label>

            <label class="option-card material-option">
              <input type="radio" name="sticker_finish" value="Matte">
              <div class="option-info">
                <span class="option-label">Vinilo Mate</span>
                <span class="option-desc">Sin reflejo, acabado suave y elegante</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Step 3: Size Selection -->
        <div class="config-step-card">
          <div class="step-title-row">
            <span class="step-badge">3</span>
            <h3 class="step-heading">Tamaño (Pulgadas)</h3>
          </div>
          <div class="options-grid grid-3">
            <label class="option-card size-option active">
              <input type="radio" name="sticker_size" value="2x2" checked>
              <span class="option-label">2" x 2"</span>
            </label>

            <label class="option-card size-option">
              <input type="radio" name="sticker_size" value="3x3">
              <span class="option-label">3" x 3"</span>
            </label>

            <label class="option-card size-option">
              <input type="radio" name="sticker_size" value="4x4">
              <span class="option-label">4" x 4"</span>
            </label>
          </div>

          <!-- Custom Size Inputs -->
          <div class="custom-size-toggle">
            <button type="button" class="btn-custom-toggle" id="ToggleCustomSize">+ Tamaño Personalizado</button>
            <div class="custom-size-inputs" id="CustomSizeContainer" style="display: none;">
              <div class="size-input-field">
                <label>Ancho (in)</label>
                <input type="number" id="CustomWidth" value="2" min="1" max="12" step="0.5">
              </div>
              <span class="size-sep">×</span>
              <div class="size-input-field">
                <label>Alto (in)</label>
                <input type="number" id="CustomHeight" value="2" min="1" max="12" step="0.5">
              </div>
            </div>
          </div>
        </div>

        <!-- Step 4: Quantity & Tier Pricing -->
        <div class="config-step-card">
          <div class="step-title-row">
            <span class="step-badge">4</span>
            <h3 class="step-heading">Selecciona la Cantidad</h3>
          </div>
          
          <div class="quantity-tiers-list" id="QuantityTiersList">
            <!-- Quantity Cards (Initial 4 shown) -->
            <label class="qty-tier-row active" data-unit-price="0.50" data-total="25.00" data-savings="0">
              <input type="radio" name="sticker_qty" value="50" checked>
              <div class="qty-main-info">
                <span class="qty-count">50 unid.</span>
                <span class="qty-price-each">$0.50 c/u</span>
              </div>
              <div class="qty-right-info">
                <span class="qty-total-price">$25.00</span>
              </div>
            </label>

            <label class="qty-tier-row" data-unit-price="0.38" data-total="38.00" data-savings="24">
              <input type="radio" name="sticker_qty" value="100">
              <div class="qty-main-info">
                <span class="qty-count">100 unid.</span>
                <span class="qty-price-each">$0.38 c/u</span>
                <span class="qty-savings-badge">Ahorra 24%</span>
              </div>
              <div class="qty-right-info">
                <span class="qty-total-price">$38.00</span>
              </div>
            </label>

            <label class="qty-tier-row" data-unit-price="0.26" data-total="65.00" data-savings="48">
              <input type="radio" name="sticker_qty" value="250">
              <div class="qty-main-info">
                <span class="qty-count">250 unid.</span>
                <span class="qty-price-each">$0.26 c/u</span>
                <span class="qty-savings-badge">Ahorra 48%</span>
              </div>
              <div class="qty-right-info">
                <span class="qty-total-price">$65.00</span>
              </div>
            </label>

            <label class="qty-tier-row" data-unit-price="0.19" data-total="95.00" data-savings="62">
              <input type="radio" name="sticker_qty" value="500">
              <div class="qty-main-info">
                <span class="qty-count">500 unid.</span>
                <span class="qty-price-each">$0.19 c/u</span>
                <span class="qty-savings-badge">Ahorra 62%</span>
              </div>
              <div class="qty-right-info">
                <span class="qty-total-price">$95.00</span>
              </div>
            </label>

            <!-- Hidden Tiers for Show More -->
            <div class="extra-tiers-container" id="ExtraTiers" style="display: none;">
              <label class="qty-tier-row" data-unit-price="0.14" data-total="140.00" data-savings="72">
                <input type="radio" name="sticker_qty" value="1000">
                <div class="qty-main-info">
                  <span class="qty-count">1,000 unid.</span>
                  <span class="qty-price-each">$0.14 c/u</span>
                  <span class="qty-savings-badge">Ahorra 72%</span>
                </div>
                <div class="qty-right-info">
                  <span class="qty-total-price">$140.00</span>
                </div>
              </label>

              <label class="qty-tier-row" data-unit-price="0.11" data-total="275.00" data-savings="78">
                <input type="radio" name="sticker_qty" value="2500">
                <div class="qty-main-info">
                  <span class="qty-count">2,500 unid.</span>
                  <span class="qty-price-each">$0.11 c/u</span>
                  <span class="qty-savings-badge">Ahorra 78%</span>
                </div>
                <div class="qty-right-info">
                  <span class="qty-total-price">$275.00</span>
                </div>
              </label>

              <label class="qty-tier-row" data-unit-price="0.09" data-total="450.00" data-savings="82">
                <input type="radio" name="sticker_qty" value="5000">
                <div class="qty-main-info">
                  <span class="qty-count">5,000 unid.</span>
                  <span class="qty-price-each">$0.09 c/u</span>
                  <span class="qty-savings-badge">Ahorra 82%</span>
                </div>
                <div class="qty-right-info">
                  <span class="qty-total-price">$450.00</span>
                </div>
              </label>
            </div>
          </div>

          <button type="button" class="btn-show-more-qty" id="ToggleMoreQty">
            Ver más cantidades ↓
          </button>
        </div>

        <!-- Step 5: Upload Design -->
        <div class="config-step-card">
          <div class="step-title-row">
            <span class="step-badge">5</span>
            <h3 class="step-heading">Sube tu Arte / Diseño</h3>
          </div>
          
          <div class="upload-dropzone" id="DropZone">
            <input type="file" id="StickerDesignFile" accept="image/*,.pdf,.ai,.psd" style="display: none;">
            <div class="upload-content" id="UploadContent">
              <div class="upload-icon">
                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
              </div>
              <span class="upload-title">Arrastra tu archivo aquí o <button type="button" class="btn-browse" onclick="document.getElementById('StickerDesignFile').click()">busca en tu equipo</button></span>
              <span class="upload-hint">Formatos soportados: PNG, JPG, PDF, AI, PSD (Máx 50MB)</span>
            </div>
            
            <div class="file-preview-card" id="FilePreview" style="display: none;">
              <span class="file-name" id="FileName">mi-diseno.png</span>
              <button type="button" class="btn-remove-file" id="RemoveFile">Quitar</button>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Sticky Live Order Summary -->
      <div class="config-summary-col">
        <div class="summary-sticky-card">
          <h3 class="summary-heading">Resumen de tu Pedido</h3>
          
          <div class="summary-details">
            <div class="summary-row">
              <span>Producto:</span>
              <strong>Stickers en Vinilo</strong>
            </div>
            <div class="summary-row">
              <span>Corte:</span>
              <strong id="SummaryShape">Die Cut</strong>
            </div>
            <div class="summary-row">
              <span>Acabado:</span>
              <strong id="SummaryFinish">Glossy</strong>
            </div>
            <div class="summary-row">
              <span>Tamaño:</span>
              <strong id="SummarySize">2" x 2"</strong>
            </div>
            <div class="summary-row">
              <span>Cantidad:</span>
              <strong id="SummaryQty">50 unid.</strong>
            </div>
            <div class="summary-row">
              <span>Precio Unitario:</span>
              <strong id="SummaryUnitPrice">$0.50</strong>
            </div>
          </div>

          <div class="summary-divider"></div>

          <div class="summary-total-box">
            <span>Total Estimado:</span>
            <span class="summary-total-price" id="SummaryTotal">$25.00</span>
          </div>

          <button type="button" class="btn-submit-order">
            Añadir al Carrito — <span id="BtnPrice">$25.00</span>
          </button>

          <div class="summary-guarantees">
            <span>✓ Prueba digital enviada antes de imprimir</span>
            <span>✓ Envío rápido o recogida disponible</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Option Card Selection Handlers
    function setupRadioGroup(cardSelector) {
      const cards = document.querySelectorAll(cardSelector);
      cards.forEach(card => {
        card.addEventListener('click', () => {
          cards.forEach(c => c.classList.remove('active'));
          card.classList.add('active');
          const radio = card.querySelector('input[type="radio"]');
          if (radio) radio.checked = true;
          updateSummary();
        });
      });
    }

    setupRadioGroup('.shape-option');
    setupRadioGroup('.material-option');
    setupRadioGroup('.size-option');

    // Quantity Tier Selection
    const qtyRows = document.querySelectorAll('.qty-tier-row');
    qtyRows.forEach(row => {
      row.addEventListener('click', () => {
        qtyRows.forEach(r => r.classList.remove('active'));
        row.classList.add('active');
        const radio = row.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
        updateSummary();
      });
    });

    // Toggle Extra Quantities
    const btnMoreQty = document.getElementById('ToggleMoreQty');
    const extraTiers = document.getElementById('ExtraTiers');
    if (btnMoreQty && extraTiers) {
      btnMoreQty.addEventListener('click', () => {
        const isHidden = extraTiers.style.display === 'none';
        extraTiers.style.display = isHidden ? 'block' : 'none';
        btnMoreQty.innerText = isHidden ? 'Ver menos cantidades ↑' : 'Ver más cantidades ↓';
      });
    }

    // Custom Size Toggle
    const toggleCustomBtn = document.getElementById('ToggleCustomSize');
    const customSizeContainer = document.getElementById('CustomSizeContainer');
    if (toggleCustomBtn && customSizeContainer) {
      toggleCustomBtn.addEventListener('click', () => {
        const isHidden = customSizeContainer.style.display === 'none';
        customSizeContainer.style.display = isHidden ? 'flex' : 'none';
        toggleCustomBtn.innerText = isHidden ? '- Usar tamaños predeterminados' : '+ Tamaño Personalizado';
        updateSummary();
      });
    }

    // File Upload Handler
    const fileInput = document.getElementById('StickerDesignFile');
    const uploadContent = document.getElementById('UploadContent');
    const filePreview = document.getElementById('FilePreview');
    const fileNameSpan = document.getElementById('FileName');
    const removeFileBtn = document.getElementById('RemoveFile');

    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        if (e.target.files.length > 0) {
          fileNameSpan.innerText = e.target.files[0].name;
          uploadContent.style.display = 'none';
          filePreview.style.display = 'flex';
        }
      });

      removeFileBtn.addEventListener('click', () => {
        fileInput.value = '';
        uploadContent.style.display = 'flex';
        filePreview.style.display = 'none';
      });
    }

    // Sync Live Order Summary
    function updateSummary() {
      const activeShape = document.querySelector('input[name="sticker_shape"]:checked');
      const activeFinish = document.querySelector('input[name="sticker_finish"]:checked');
      const activeSize = document.querySelector('input[name="sticker_size"]:checked');
      const activeQtyRow = document.querySelector('.qty-tier-row.active');

      if (activeShape) document.getElementById('SummaryShape').innerText = activeShape.value;
      if (activeFinish) document.getElementById('SummaryFinish').innerText = activeFinish.value;

      // Handle custom size vs preset size
      if (customSizeContainer && customSizeContainer.style.display !== 'none') {
        const w = document.getElementById('CustomWidth').value || 0;
        const h = document.getElementById('CustomHeight').value || 0;
        document.getElementById('SummarySize').innerText = `${w}" x ${h}"`;
      } else if (activeSize) {
        document.getElementById('SummarySize').innerText = `${activeSize.value}"`;
      }

      if (activeQtyRow) {
        const qtyVal = activeQtyRow.querySelector('input').value;
        const totalVal = activeQtyRow.getAttribute('data-total');
        const unitVal = activeQtyRow.getAttribute('data-unit-price');

        document.getElementById('SummaryQty').innerText = `${qtyVal} unid.`;
        document.getElementById('SummaryUnitPrice').innerText = `$${unitVal}`;
        document.getElementById('SummaryTotal').innerText = `$${totalVal}`;
        document.getElementById('BtnPrice').innerText = `$${totalVal}`;
      }
    }

    // Attach listeners to custom inputs
    document.getElementById('CustomWidth').addEventListener('input', updateSummary);
    document.getElementById('CustomHeight').addEventListener('input', updateSummary);
  });
</script>

{% stylesheet %}
.sticker-config-wrapper {
  width: 100%;
  background-color: var(--bg-color);
  padding-top: var(--padding-v);
  padding-bottom: var(--padding-v);
  padding-left: 20px;
  padding-right: 20px;
  box-sizing: border-box;
  color: var(--text-color);
}

.sticker-config-container {
  max-width: var(--max-width);
  margin: 0 auto;
}

.config-subheading {
  display: block;
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--accent-yellow);
  margin-bottom: 8px;
}

.config-heading {
  font-size: 42px;
  font-weight: 900;
  letter-spacing: -1px;
  margin: 0 0 40px 0;
}

/* GRID LAYOUT */
.config-grid {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 32px;
  align-items: start;
}

/* CARDS & STEPS */
.config-steps-col {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.config-step-card {
  background-color: var(--card-bg);
  border-radius: 20px;
  padding: 28px;
  box-sizing: border-box;
}

.step-title-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.step-badge {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: var(--accent-yellow);
  color: #000000;
  font-size: 15px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-heading {
  font-size: 20px;
  font-weight: 800;
  margin: 0;
}

/* OPTION GRIDS */
.options-grid {
  display: grid;
  gap: 12px;
}

.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-2 { grid-template-columns: repeat(2, 1fr); }

.option-card {
  border: 2px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  padding: 16px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background-color: rgba(255, 255, 255, 0.02);
  transition: all 0.2s ease;
  user-select: none;
}

.option-card input[type="radio"] {
  display: none;
}

.option-card:hover {
  border-color: rgba(255, 255, 255, 0.3);
}

.option-card.active {
  border-color: var(--accent-yellow);
  background-color: rgba(255, 204, 0, 0.06);
}

.option-icon {
  margin-bottom: 8px;
  color: var(--text-color);
}

.option-label {
  font-size: 15px;
  font-weight: 800;
}

.option-desc {
  font-size: 12px;
  color: var(--text-sub);
  margin-top: 4px;
}

.material-option {
  text-align: left;
  align-items: flex-start;
}

/* CUSTOM SIZE INPUTS */
.custom-size-toggle {
  margin-top: 16px;
}

.btn-custom-toggle {
  background: none;
  border: none;
  color: var(--accent-yellow);
  font-weight: 700;
  cursor: pointer;
  padding: 0;
  font-size: 14px;
}

.custom-size-inputs {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
}

.size-input-field {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.size-input-field label {
  font-size: 12px;
  color: var(--text-sub);
}

.size-input-field input {
  width: 90px;
  background-color: rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  color: #ffffff;
  padding: 10px;
  font-size: 15px;
  font-weight: 700;
}

.size-sep {
  font-size: 18px;
  margin-top: 18px;
  color: var(--text-sub);
}

/* QUANTITY TIERS */
.quantity-tiers-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.qty-tier-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 14px 18px;
  cursor: pointer;
  background-color: rgba(255, 255, 255, 0.02);
  transition: all 0.2s ease;
}

.qty-tier-row input { display: none; }

.qty-tier-row:hover {
  border-color: rgba(255, 255, 255, 0.2);
}

.qty-tier-row.active {
  border-color: var(--accent-yellow);
  background-color: rgba(255, 204, 0, 0.06);
}

.qty-main-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.qty-count {
  font-size: 16px;
  font-weight: 800;
}

.qty-price-each {
  font-size: 13px;
  color: var(--text-sub);
}

.qty-savings-badge {
  background-color: #16a34a;
  color: #ffffff;
  font-size: 11px;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 20px;
}

.qty-total-price {
  font-size: 16px;
  font-weight: 800;
}

.btn-show-more-qty {
  width: 100%;
  background: none;
  border: 1px dashed rgba(255, 255, 255, 0.2);
  color: var(--text-color);
  padding: 12px;
  border-radius: 10px;
  font-weight: 700;
  margin-top: 12px;
  cursor: pointer;
  transition: background 0.2s ease;
}

.btn-show-more-qty:hover {
  background-color: rgba(255, 255, 255, 0.05);
}

/* FILE UPLOAD DROPZONE */
.upload-dropzone {
  border: 2px dashed rgba(255, 255, 255, 0.2);
  border-radius: 14px;
  padding: 28px;
  text-align: center;
  background-color: rgba(0, 0, 0, 0.2);
}

.upload-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.upload-title {
  font-size: 15px;
  font-weight: 700;
}

.btn-browse {
  background: none;
  border: none;
  color: var(--accent-yellow);
  text-decoration: underline;
  font-weight: 800;
  cursor: pointer;
}

.upload-hint {
  font-size: 12px;
  color: var(--text-sub);
}

.file-preview-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: rgba(255, 255, 255, 0.08);
  padding: 12px 16px;
  border-radius: 8px;
}

.btn-remove-file {
  background: none;
  border: none;
  color: #ef4444;
  font-weight: 800;
  cursor: pointer;
}

/* RIGHT SUMMARY CARD */
.summary-sticky-card {
  position: sticky;
  top: 40px;
  background-color: var(--card-bg);
  border-radius: 20px;
  padding: 28px;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.summary-heading {
  font-size: 22px;
  font-weight: 900;
  margin: 0 0 20px 0;
}

.summary-details {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
}

.summary-row span {
  color: var(--text-sub);
}

.summary-divider {
  height: 1px;
  background-color: rgba(255, 255, 255, 0.1);
  margin: 20px 0;
}

.summary-total-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  font-size: 16px;
  font-weight: 800;
}

.summary-total-price {
  font-size: 28px;
  font-weight: 900;
  color: var(--accent-yellow);
}

.btn-submit-order {
  width: 100%;
  background-color: var(--accent-yellow);
  color: #000000;
  border: none;
  padding: 18px;
  border-radius: 50px;
  font-size: 16px;
  font-weight: 900;
  cursor: pointer;
  transition: transform 0.15s ease;
}

.btn-submit-order:hover {
  transform: translateY(-2px);
}

.summary-guarantees {
  margin-top: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 12px;
  color: var(--text-sub);
}

/* RESPONSIVE */
@media (max-width: 960px) {
  .config-grid {
    grid-template-columns: 1fr;
  }
  .grid-3 {
    grid-template-columns: 1fr;
  }
  .grid-2 {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

