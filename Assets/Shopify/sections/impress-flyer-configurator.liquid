{{ 'impress-paper-configurator.css' | asset_url | stylesheet_tag }}
{{ 'impress-preview-shared.css' | asset_url | stylesheet_tag }}
<script src="{{ 'impress-addons.js' | asset_url }}" defer></script>
<script src="{{ 'impress-variant-mapping.js' | asset_url }}" defer></script>
<script src="{{ 'impress-editor-core.js' | asset_url }}" defer></script>
<script src="{{ 'impress-artwork-source.js' | asset_url }}" defer></script>
<script src="{{ 'impress-artwork-preview.js' | asset_url }}" defer></script>
<script src="{{ 'impress-artwork-quality.js' | asset_url }}" defer></script>
