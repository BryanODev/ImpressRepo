
<div class="impress-catalog" style="
  --catalog-padding-v: {{ section.settings.vertical_padding }}px;
  --catalog-max-width: {{ section.settings.max_width }}px;
  --catalog-gap: {{ section.settings.grid_gap }}px;
  --catalog-card-radius: {{ section.settings.corner_radius }}px;
  --catalog-card-bg: {{ section.settings.card_bg_color }};
  --catalog-text-color: {{ section.settings.text_color }};
  --catalog-muted: {{ section.settings.muted_text_color }};
  --catalog-accent: {{ section.settings.accent_color }};
">
  <div class="impress-catalog__container">
    <div class="impress-catalog__header">
      <div>
        {% if section.settings.section_subheading != blank %}
          <p class="impress-catalog__eyebrow">{{ section.settings.section_subheading }}</p>
        {% endif %}
        {% if section.settings.section_heading != blank %}
          <h2 class="impress-catalog__title">{{ section.settings.section_heading }}</h2>
        {% endif %}
      </div>
      {% if section.settings.section_helper != blank %}
        <p class="impress-catalog__helper">{{ section.settings.section_helper }}</p>
      {% endif %}
    </div>

    <div class="impress-catalog__grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.card_link | default: '#' }}" class="impress-catalog-card" {{ block.shopify_attributes }}>
          <div class="impress-catalog-card__content">
            {% if block.settings.eyebrow != blank %}
              <span class="impress-catalog-card__eyebrow">{{ block.settings.eyebrow }}</span>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="impress-catalog-card__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="impress-catalog-card__description">{{ block.settings.description }}</p>
            {% endif %}
            <span class="impress-catalog-card__cta">{{ block.settings.cta_label | default: 'Ver producto' }} <span aria-hidden="true">→</span></span>
          </div>
          <div class="impress-catalog-card__media">
            {% if block.settings.card_image != blank %}
              <img 
                src="{{ block.settings.card_image | image_url: width: 900 }}"
                alt="{{ block.settings.title | escape }}"
                width="{{ block.settings.card_image.width }}"
                height="{{ block.settings.card_image.height }}"
                loading="lazy"
              >
            {% else %}
              <div class="impress-catalog-card__placeholder">
                <span class="impress-catalog-card__shape impress-catalog-card__shape--one"></span>
                <span class="impress-catalog-card__shape impress-catalog-card__shape--two"></span>
                <span class="impress-catalog-card__shape impress-catalog-card__shape--three"></span>
              </div>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
.impress-catalog {
  padding: var(--catalog-padding-v) 20px;
}
.impress-catalog__container {
  max-width: var(--catalog-max-width);
  margin: 0 auto;
}
.impress-catalog__header {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 28px;
}
.impress-catalog__eyebrow {
  margin: 0 0 10px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--catalog-accent);
}
.impress-catalog__title {
  margin: 0;
  font-size: clamp(30px, 3vw, 42px);
  line-height: 1.05;
  letter-spacing: -0.03em;
  font-weight: 900;
  color: #101114;
}
.impress-catalog__helper {
  max-width: 440px;
  margin: 0;
  font-size: 15px;
  line-height: 1.5;
  color: #61646c;
}
.impress-catalog__grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: var(--catalog-gap);
}
.impress-catalog-card {
  grid-column: span 6;
  min-height: 250px;
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(180px, .8fr);
  gap: 22px;
  align-items: center;
  padding: 28px;
  border-radius: var(--catalog-card-radius);
  background:
    radial-gradient(circle at top right, rgba(251, 191, 0, 0.22), transparent 34%),
    linear-gradient(180deg, color-mix(in srgb, var(--catalog-card-bg) 92%, white 8%), var(--catalog-card-bg));
  color: var(--catalog-text-color);
  text-decoration: none;
  border: 1px solid rgba(255,255,255,.08);
  box-shadow: 0 16px 34px rgba(0,0,0,.12);
  overflow: hidden;
  position: relative;
  transition: transform .24s cubic-bezier(.16,1,.3,1), box-shadow .24s ease, border-color .24s ease;
}
.impress-catalog-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 22px 44px rgba(0,0,0,.18);
  border-color: rgba(251,191,0,.3);
}
.impress-catalog-card::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  border: 1px solid rgba(255,255,255,.06);
  pointer-events: none;
}
.impress-catalog-card__content {
  position: relative;
  z-index: 1;
}
.impress-catalog-card__eyebrow {
  display: inline-flex;
  align-items: center;
  min-height: 28px;
  padding: 0 12px;
  margin-bottom: 14px;
  border-radius: 999px;
  background: rgba(255,255,255,.08);
  color: #f6f7fb;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .9px;
  text-transform: uppercase;
}
.impress-catalog-card__title {
  margin: 0 0 10px;
  color: var(--catalog-text-color);
  font-size: clamp(24px, 2.4vw, 34px);
  line-height: 1.02;
  letter-spacing: -0.03em;
  font-weight: 900;
}
.impress-catalog-card__description {
  margin: 0 0 18px;
  max-width: 34ch;
  color: var(--catalog-muted);
  font-size: 15px;
  line-height: 1.5;
}
.impress-catalog-card__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 800;
  color: #ffffff;
}
.impress-catalog-card__cta span {
  transition: transform .2s ease;
}
.impress-catalog-card:hover .impress-catalog-card__cta span {
  transform: translateX(4px);
}
.impress-catalog-card__media {
  position: relative;
  min-height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.impress-catalog-card__media img {
  width: 100%;
  height: 100%;
  max-height: 210px;
  object-fit: contain;
  filter: drop-shadow(0 12px 26px rgba(0,0,0,.28));
  transition: transform .28s ease;
}
.impress-catalog-card:hover .impress-catalog-card__media img {
  transform: scale(1.04) rotate(-2deg);
}
.impress-catalog-card__placeholder {
  width: 100%;
  aspect-ratio: 1 / 1;
  position: relative;
}
.impress-catalog-card__shape {
  position: absolute;
  display: block;
  background: linear-gradient(180deg, #ffd84a, #fbbf00);
  box-shadow: 0 18px 40px rgba(0,0,0,.24);
}
.impress-catalog-card__shape--one {
  inset: 18% 24% 18% 14%;
  border-radius: 34px;
  transform: rotate(-8deg);
}
.impress-catalog-card__shape--two {
  width: 42%;
  height: 42%;
  right: 10%;
  top: 14%;
  border-radius: 999px;
}
.impress-catalog-card__shape--three {
  width: 40%;
  height: 20%;
  left: 8%;
  bottom: 10%;
  border-radius: 18px;
}
@media (max-width: 989px) {
  .impress-catalog__header {
    flex-direction: column;
    align-items: flex-start;
  }
  .impress-catalog-card {
    grid-column: span 12;
  }
}
@media (max-width: 768px) {
  .impress-catalog { padding: var(--catalog-padding-v) 16px; }
  .impress-catalog__grid { grid-template-columns: 1fr; }
  .impress-catalog-card {
    grid-column: auto;
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 22px;
    min-height: auto;
  }
  .impress-catalog-card__media { order: -1; min-height: 120px; }
  .impress-catalog-card__media img { max-height: 140px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Impress Catalog Grid",
  "settings": [
    { "type": "text", "id": "section_subheading", "label": "Section Eyebrow", "default": "Productos principales" },
    { "type": "text", "id": "section_heading", "label": "Section Heading", "default": "Ordena por tipo de producto" },
    { "type": "textarea", "id": "section_helper", "label": "Helper Text", "default": "Selecciona el producto que necesitas y personalízalo directamente online." },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Card Corner Roundness", "default": 22 },
    { "type": "range", "id": "grid_gap", "min": 10, "max": 36, "step": 2, "unit": "px", "label": "Space Between Cards", "default": 22 },
    { "type": "range", "id": "max_width", "min": 900, "max": 1440, "step": 20, "unit": "px", "label": "Container Max Width", "default": 1240 },
    { "type": "range", "id": "vertical_padding", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Top & Bottom Spacing", "default": 45 },
    { "type": "color", "id": "card_bg_color", "label": "Card Background", "default": "#0e1014" },
    { "type": "color", "id": "text_color", "label": "Main Text Color", "default": "#ffffff" },
    { "type": "color", "id": "muted_text_color", "label": "Description Color", "default": "#b3b5bd" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#fbbf00" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "card_image", "label": "Product Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ordena online" },
        { "type": "text", "id": "title", "label": "Title", "default": "Vinyl Stickers" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Sube tu diseño, elige corte, acabado y cantidad." },
        { "type": "text", "id": "cta_label", "label": "CTA Label", "default": "Personalizar" },
        { "type": "url", "id": "card_link", "label": "Card Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Impress Catalog Grid",
      "blocks": [
        { "type": "product_card", "settings": { "title": "Vinyl Stickers" } },
        { "type": "product_card", "settings": { "title": "Banners" } },
        { "type": "product_card", "settings": { "title": "Business Cards" } },
        { "type": "product_card", "settings": { "title": "Postcards" } }
      ]
    }
  ]
}
{% endschema %}
