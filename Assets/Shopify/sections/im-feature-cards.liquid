{% comment %}
  IM | Feature Cards
  Reusable editorial image cards with editable content and destinations.
{% endcomment %}
<section id="im-feature-{{ section.id }}" class="im-feature" style="
  --imf-bg: {{ section.settings.background }};
  --imf-max: {{ section.settings.max_width }}px;
  --imf-gap: {{ section.settings.card_gap }}px;
  --imf-radius: {{ section.settings.corner_radius }}px;
  --imf-top: {{ section.settings.padding_top }}px;
  --imf-bottom: {{ section.settings.padding_bottom }}px;
  --imf-cols: {{ section.settings.columns }};
">
  <div class="im-feature__inner">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <header class="im-feature__header">
        {% if section.settings.heading != blank %}
          <h2 class="im-feature__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="im-feature__description rte">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}
    <div class="im-feature__grid">
      {% for block in section.blocks %}
        {% liquid
          assign has_link = false
          if block.settings.link != blank
            assign has_link = true
          endif
        %}
        <article class="im-feature__card" {{ block.shopify_attributes }}>
          {% if has_link %}<a class="im-feature__card-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | default: 'Explorar' | escape }}">{% endif %}
            <div class="im-feature__image-wrap">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1400 | image_tag: class: 'im-feature__image', loading: 'lazy', widths: '320, 480, 640, 800, 1000, 1400', sizes: '(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw' }}
              {% else %}
                <div class="im-feature__image-empty" aria-hidden="true"></div>
              {% endif %}
            </div>
            <div class="im-feature__overlay"></div>
            <div class="im-feature__content">
              {% if block.settings.eyebrow != blank %}<span class="im-feature__eyebrow">{{ block.settings.eyebrow | escape }}</span>{% endif %}
              {% if block.settings.title != blank %}<h3 class="im-feature__title">{{ block.settings.title | escape }}</h3>{% endif %}
              {% if block.settings.description != blank %}<p class="im-feature__text">{{ block.settings.description | escape }}</p>{% endif %}
            </div>
          {% if has_link %}</a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #im-feature-{{ section.id }}{background:var(--imf-bg);padding:var(--imf-top) 20px var(--imf-bottom)}
  #im-feature-{{ section.id }} .im-feature__inner{max-width:var(--imf-max);margin-inline:auto}
  #im-feature-{{ section.id }} .im-feature__header{text-align:center;max-width:760px;margin:0 auto 43px}
  #im-feature-{{ section.id }} .im-feature__heading{font-size:clamp(28px,3vw,40px);font-weight:850;letter-spacing:-.035em;line-height:1.12;margin:0 0 16px;color:#111}
  #im-feature-{{ section.id }} .im-feature__description{font-size:16px;line-height:1.65;color:#353535}
  #im-feature-{{ section.id }} .im-feature__description p{margin:0}
  #im-feature-{{ section.id }} .im-feature__grid{display:grid;grid-template-columns:repeat(var(--imf-cols),minmax(0,1fr));gap:var(--imf-gap)}
  #im-feature-{{ section.id }} .im-feature__card{position:relative;min-width:0;aspect-ratio:{{ section.settings.card_ratio }};overflow:hidden;border-radius:var(--imf-radius);background:#e8e8e8;isolation:isolate;box-shadow:0 4px 9px rgba(0,0,0,.12);transition:transform .25s ease,box-shadow .25s ease}
  #im-feature-{{ section.id }} .im-feature__card-link{position:absolute;inset:0;display:block;color:inherit;text-decoration:none}
  #im-feature-{{ section.id }} .im-feature__image-wrap{position:absolute;inset:0}
  #im-feature-{{ section.id }} .im-feature__image{width:100%;height:100%;object-fit:cover;display:block;transition:transform .55s cubic-bezier(.2,.7,.2,1)}
  #im-feature-{{ section.id }} .im-feature__image-empty{width:100%;height:100%;background:#e8e8e8}
  #im-feature-{{ section.id }} .im-feature__overlay{position:absolute;inset:0;background:linear-gradient(180deg,transparent 28%,rgba(0,0,0,.12) 43%,rgba(0,0,0,.88) 100%);pointer-events:none}
  #im-feature-{{ section.id }} .im-feature__content{position:absolute;left:24px;right:24px;bottom:24px;z-index:1;pointer-events:none}
  #im-feature-{{ section.id }} .im-feature__eyebrow{display:block;color:#fbbf00;font-weight:850;font-size:14px;line-height:1.2;text-transform:uppercase;letter-spacing:.01em;margin-bottom:5px}
  #im-feature-{{ section.id }} .im-feature__title{color:#fff;font-weight:850;font-size:clamp(22px,2.4vw,32px);line-height:1.13;letter-spacing:-.02em;margin:0 0 9px}
  #im-feature-{{ section.id }} .im-feature__text{color:#fff;font-size:15px;line-height:1.5;margin:0}
  @media(hover:hover){#im-feature-{{ section.id }} .im-feature__card:hover{transform:translateY(-4px);box-shadow:0 12px 24px rgba(0,0,0,.16)}#im-feature-{{ section.id }} .im-feature__card:hover .im-feature__image{transform:scale(1.045)}}
  #im-feature-{{ section.id }} .im-feature__card-link:focus-visible{outline:3px solid #fbbf00;outline-offset:-4px}
  @media(max-width:900px){#im-feature-{{ section.id }} .im-feature__grid{grid-template-columns:repeat(2,minmax(0,1fr))}#im-feature-{{ section.id }} .im-feature__content{left:20px;right:20px;bottom:20px}}
  @media(max-width:600px){#im-feature-{{ section.id }}{padding-left:16px;padding-right:16px}#im-feature-{{ section.id }} .im-feature__grid{grid-template-columns:1fr;gap:16px}#im-feature-{{ section.id }} .im-feature__header{margin-bottom:28px}#im-feature-{{ section.id }} .im-feature__card{aspect-ratio:4/4.2}#im-feature-{{ section.id }} .im-feature__title{font-size:27px}}
  @media(prefers-reduced-motion:reduce){#im-feature-{{ section.id }} .im-feature__card,#im-feature-{{ section.id }} .im-feature__image{transition:none}}
</style>

{% schema %}
{
  "name": "IM Feature Cards",
  "tag": "section",
  "class": "im-feature-cards-section",
  "max_blocks": 12,
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"¿Buscas algo diferente?"},
    {"type":"richtext","id":"description","label":"Description","default":"<p>Descubre más ideas y formas de aprovechar nuestros productos personalizados.</p>"},
    {"type":"range","id":"columns","label":"Columns (desktop)","min":2,"max":4,"step":1,"default":3},
    {"type":"select","id":"card_ratio","label":"Card proportions (desktop)","options":[{"value":"3/4","label":"Portrait"},{"value":"4/5","label":"Tall"},{"value":"1/1","label":"Square"}],"default":"4/5"},
    {"type":"range","id":"card_gap","label":"Card spacing","min":8,"max":40,"step":2,"default":30,"unit":"px"},
    {"type":"range","id":"corner_radius","label":"Rounded corners","min":0,"max":32,"step":2,"default":16,"unit":"px"},
    {"type":"range","id":"max_width","label":"Maximum width","min":900,"max":1500,"step":20,"default":1240,"unit":"px"},
    {"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":120,"step":5,"default":70,"unit":"px"},
    {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":120,"step":5,"default":70,"unit":"px"},
    {"type":"color","id":"background","label":"Background","default":"#ffffff"}
  ],
  "blocks": [
    {"type":"card","name":"Image card","settings":[
      {"type":"image_picker","id":"image","label":"Image"},
      {"type":"text","id":"eyebrow","label":"Small label","default":"DESCUBRE"},
      {"type":"text","id":"title","label":"Title","default":"Explora más opciones"},
      {"type":"textarea","id":"description","label":"Short description","default":"Descubre productos y posibilidades para tu próximo proyecto."},
      {"type":"url","id":"link","label":"Card link"}
    ]}
  ],
  "presets":[
    {"name":"IM Feature Cards","blocks":[
      {"type":"card","settings":{"eyebrow":"STICKERS","title":"Stickers para cada idea","description":"Encuentra el estilo ideal para tu proyecto."}},
      {"type":"card","settings":{"eyebrow":"USOS","title":"Hechos para destacar","description":"Descubre nuevas formas de promocionar tu marca."}},
      {"type":"card","settings":{"eyebrow":"PRODUCTOS","title":"Más posibilidades","description":"Explora otras opciones de impresión."}}
    ]}
  ]
}
{% endschema %}
